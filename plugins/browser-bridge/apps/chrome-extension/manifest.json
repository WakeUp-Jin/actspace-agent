{
  "manifest_version": 3,
  "name": "ActSpace Browser",
  "version": "0.2.2",
  "description": "Connect ActSpace to your Chrome tabs for visible, permission-aware browser automation.",
  "key": "",
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "action": {
    "default_title": "ActSpace Browser",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png"
    }
  },
  "permissions": [
    "debugger",
    "downloads",
    "history",
    "nativeMessaging",
    "tabs",
    "tabGroups"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/cursor-overlay.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "minimum_chrome_version": "116"
}
