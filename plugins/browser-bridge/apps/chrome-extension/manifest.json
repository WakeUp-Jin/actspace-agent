{
  "manifest_version": 3,
  "name": "Agent Browser Bridge",
  "version": "0.2.1",
  "description": "Chrome extension backend for the Agent Browser Bridge — enables Agent to interact with and control browser tabs.",
  "key": "",
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": [
    "debugger",
    "downloads",
    "history",
    "nativeMessaging",
    "tabs",
    "tabGroups"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/cursor-overlay.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "minimum_chrome_version": "116"
}
