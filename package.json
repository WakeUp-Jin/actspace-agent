{
  "name": "actspace",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "clean": "pnpm --filter @actspace/shared clean && pnpm --filter @actspace/agent-core clean && pnpm --filter @actspace/agent-cli clean && pnpm --filter @actspace/desktop clean",
    "dev": "pnpm --filter @actspace/desktop dev",
    "dev:log": "./scripts/dev-with-logs.sh",
    "build": "pnpm --filter @actspace/agent-cli build && pnpm --filter @actspace/desktop build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r typecheck",
    "ci": "./scripts/ci.sh",
    "check:docs": "./scripts/check-docs.sh",
    "check:secrets": "./scripts/check-secrets.sh",
    "check:repo": "./scripts/check-repo-hygiene.sh",
    "check:actions": "./scripts/check-action-pinning.sh",
    "check:browser": "node --check plugins/browser-bridge/apps/chrome-extension/src/background.js && node scripts/check-browser-command-registry.mjs && node scripts/test-browser-locator-runtime.mjs && node scripts/test-browser-extension-contract.mjs",
    "hooks:install": "./scripts/install-git-hooks.sh",
    "package:desktop": "./scripts/release-package.sh",
    "package:desktop:dmg": "./scripts/release-package.sh",
    "release-package": "./scripts/release-package.sh"
  }
}
