# ─── actspace 环境变量 ───
# 复制为 .env 并填写你的值。.env 已被 .gitignore 忽略。

# ─── 运行环境 ───
NODE_ENV=development

# ─── LLM 配置 ───
# provider: "deepseek" | "mock"
LLM_PROVIDER=mock
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=8192

# ─── DeepSeek ───
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ─── 应用设置 ───
LOG_LEVEL=info
# 快捷开关：设为 true 跳过真实 API 调用，使用 mock provider
MOCK_MODE=true
