# ─── actspace 环境变量 ───
# 复制为 .env 并填写你的值。.env 已被 .gitignore 忽略。

# ─── 运行环境 ───
NODE_ENV=development

# ─── LLM 配置 ───
# 主模型由前端模型选择器驱动（deepseek-v4-flash / deepseek-v4-pro / kimi-k2.6），
# 不再依赖 LLM_PROVIDER 和 LLM_MODEL 来决定主模型。
# LLM_PROVIDER 和 LLM_MODEL 仅作为 mock/测试场景的 fallback。
# Electron 真实会话不会因为 MOCK_MODE 自动降级为 mock provider。
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=8192

# ─── DeepSeek ───
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ─── Kimi ───
# LLM_PROVIDER=kimi 时 KIMI_API_KEY 必填。
# LLM_PROVIDER=deepseek 时 KIMI_API_KEY 可选；填写后会启用 web_search、web_fetch、analyze_media 辅助工具。
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k2.6

# ─── 应用设置 ───
LOG_LEVEL=info
# 仅供测试脚本或浏览器 fixture 使用；桌面端真实 turn 默认走 LLM_PROVIDER。
MOCK_MODE=false
# 可选：用逗号分隔禁用指定工具，例如 read_file,bash
ACTSPACE_DISABLED_TOOLS=
# 调试开关：所有 bash 命令都进入审核（绕过 allowlist），硬拒绝仍生效。
# 设为 1 / true 启用；测试完务必删除或改回 0。
ACTSPACE_BASH_ALWAYS_ASK=0

# ─── Kairos 后台 Agent ───
# Kairos 用哪个模型，可选值同主 Agent：deepseek-v4-flash / deepseek-v4-pro / kimi-k2.6。
# 留空 → 自动复用主 Agent 默认模型；填非法值会被忽略并回落到默认。
KAIROS_MODEL_ID=
# 思考链覆写：
#   auto（缺省）→ 跟随所选模型的 thinkingDefault
#   true        → 强制启用（仅在模型 supportsThinkingToggle=true 时生效，如 deepseek-v4-pro / kimi-k2.6）
#   false       → 强制禁用
# 模型不支持 toggle（如 deepseek-v4-flash）时本字段被忽略。
KAIROS_THINKING=auto
