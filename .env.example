# Actspace 进程环境变量示例
#
# Desktop 的 provider key 不从本文件读取。请在应用内“设置”页面配置；
# Electron main 会把凭据写入权限为 0600 的 <userData>/secrets.json。
# 本文件主要用于 CLI、CI、显式调试开关和首次设置默认值。

NODE_ENV=development

# CLI LLM 路由。LLM_PROVIDER 默认 deepseek；LLM_API 可选
# openai-completions、openai-responses、anthropic-messages。
LLM_PROVIDER=deepseek
LLM_API=openai-completions
LLM_MODEL=deepseek-chat
LLM_PROXY_URL=

# CLI provider credentials。只填写当前 CLI 运行需要的 provider。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# CLI concrete tools。Desktop 对应凭据由设置页管理。
ZHIPU_API_KEY=
TAVILY_API_KEY=
TINYFISH_API_KEY=
EXA_API_KEY=
IMAGE_GENERATION_API_KEY=
IMAGE_GENERATION_BASE_URL=https://www.duckcoding.ai/v1
IMAGE_GENERATION_MODEL=gpt-image-2

# Desktop 首次创建 settings.json 时可读取的非敏感默认值；后续以设置文件为准。
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=8192
ACTSPACE_DISABLED_TOOLS=
ACTSPACE_BASH_ALWAYS_ASK=0

# Host / 开发路径覆盖。
ACTSPACE_WORKSPACE_ROOT=
ACTSPACE_REPO_ROOT=
ACTSPACE_LOG_STDERR=0

# Browser Bridge 调试覆盖。正常安装不需要设置。
ABB_SOCKET=
ABB_SUPPORT_DIR=
