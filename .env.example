# ─── actspace 环境变量 ───
# 复制为 .env 并填写你的值。.env 已被 .gitignore 忽略。

# ─── 运行环境 ───
NODE_ENV=development

# ─── LLM 配置 ───
# 主模型由前端模型选择器驱动（deepseek-v4-flash / deepseek-v4-pro / kimi-k2.6），
# 不再依赖 LLM_PROVIDER 和 LLM_MODEL 来决定主模型。
# LLM_PROVIDER 和 LLM_MODEL 仅作为 mock/测试场景的 fallback。
# Electron 真实会话不会因为 MOCK_MODE 自动降级为 mock provider。
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=8192

# ─── DeepSeek ───
# API Key 推荐在桌面端「设置 → 模型」里填写，会经系统密钥串加密存到本机；
# UI 的「已连接/断开」只认页面保存的 Key，不再把这里的 DEEPSEEK_API_KEY 当作已连接。
# 若仍想用 .env 直接跑（如纯脚本 / CI），可在此填写；但要在 UI 里彻底断开需从这里移除。
DEEPSEEK_API_KEY=
# 可选：anthropic = 默认路线并启用 DeepSeek server web_search；openai = 临时回退到旧 OpenAI-compatible 路线。
DEEPSEEK_API_FORMAT=anthropic
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# ─── Kimi ───
# 同上：API Key 推荐在桌面端「设置 → 模型」里填写并加密存本机。
# 填写后会启用 web_search、analyze_media 辅助工具（取决于主模型与 DEEPSEEK_API_FORMAT）。
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k2.6

# ─── 应用设置 ───
LOG_LEVEL=info
# 仅供测试脚本或浏览器 fixture 使用；桌面端真实 turn 默认走 LLM_PROVIDER。
MOCK_MODE=false
# 可选：用逗号分隔禁用指定工具，例如 read_file,bash
ACTSPACE_DISABLED_TOOLS=
# 调试开关：所有 bash 命令都进入审核（绕过 allowlist），硬拒绝仍生效。
# 设为 1 / true 启用；测试完务必删除或改回 0。
ACTSPACE_BASH_ALWAYS_ASK=0

# ─── Kairos 后台 Agent ───
# Kairos 用哪个模型，可选值同主 Agent：deepseek-v4-flash / deepseek-v4-pro / kimi-k2.6。
# 留空或填非法值 → 回落到 Kairos 默认 deepseek-v4-flash；不会跟随主 Agent 默认模型。
KAIROS_MODEL_ID=deepseek-v4-flash
# 思考链覆写：
#   true（缺省）→ 强制启用（仅在模型 supportsThinkingToggle=true 时生效）
#   false       → 强制禁用
#   auto        → 跟随所选模型的 thinkingDefault
KAIROS_THINKING=true
