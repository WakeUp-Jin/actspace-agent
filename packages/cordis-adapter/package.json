{
  "name": "@actspace/cordis-adapter",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./plugin-contract": {
      "types": "./dist/plugin-contract.d.ts",
      "import": "./dist/plugin-contract.js",
      "default": "./dist/plugin-contract.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js",
      "default": "./dist/manifest.js"
    },
    "./codec": {
      "types": "./dist/codec-discovery.d.ts",
      "import": "./dist/codec-discovery.js",
      "default": "./dist/codec-discovery.js"
    },
    "./behavior": {
      "types": "./dist/behavior-loader.d.ts",
      "import": "./dist/behavior-loader.js",
      "default": "./dist/behavior-loader.js"
    },
    "./cordis": {
      "types": "./dist/cordis-root.d.ts",
      "import": "./dist/cordis-root.js",
      "default": "./dist/cordis-root.js"
    },
    "./service": {
      "types": "./dist/service-contract.d.ts",
      "import": "./dist/service-contract.js",
      "default": "./dist/service-contract.js"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "import": "./dist/events.js",
      "default": "./dist/events.js"
    },
    "./source-loader": {
      "types": "./dist/source-loader.d.ts",
      "import": "./dist/source-loader.js",
      "default": "./dist/source-loader.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-loader": "1.0.2",
    "@deepseek-ai/cordis-plugin-include": "1.0.6",
    "@deepseek-ai/cordis-plugin-group": "1.0.1",
    "@deepseek-ai/cordis-plugin-timer": "1.1.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
