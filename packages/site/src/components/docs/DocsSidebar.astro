---
import type { DocsEntry } from "../../lib/docs-navigation";
import { docsGroups, docsHref } from "../../lib/docs-navigation";
import { sitePath } from "../../lib/site-path";

interface Props {
  docs: DocsEntry[];
  currentId?: string;
}

const { docs, currentId } = Astro.props;
---

<nav class="docs-sidebar" aria-label="文档目录" data-docs-sidebar>
  <a class="docs-home" href={sitePath("/docs/")}>ActSpace 文档</a>
  <div class="docs-search">
    <label for={`docs-search-${currentId ?? "home"}`} class="sr-only">搜索文档标题</label>
    <input id={`docs-search-${currentId ?? "home"}`} type="search" placeholder="搜索文档…" data-docs-search />
    <p class="sr-only" aria-live="polite" data-docs-search-status></p>
  </div>
  {docsGroups.map((group) => {
    const entries = docs.filter((entry) => entry.data.group === group.id);
    return entries.length > 0 && (
      <section data-docs-group>
        <h2>{group.label}</h2>
        <ul>
          {entries.map((entry) => (
            <li data-docs-search-item>
              <a class:list={{ active: entry.id === currentId }} href={sitePath(docsHref(entry))} aria-current={entry.id === currentId ? "page" : undefined}>
                {entry.data.title}
              </a>
            </li>
          ))}
        </ul>
      </section>
    );
  })}

  <details class="mobile-docs-nav">
    <summary>浏览全部文档</summary>
    {docsGroups.map((group) => (
      <section>
        <h2>{group.label}</h2>
        <ul>
          {docs.filter((entry) => entry.data.group === group.id).map((entry) => (
            <li><a class:list={{ active: entry.id === currentId }} href={sitePath(docsHref(entry))}>{entry.data.title}</a></li>
          ))}
        </ul>
      </section>
    ))}
  </details>
</nav>

<script>
  import { initializeDocsSearch } from "../../scripts/docs-search";

  initializeDocsSearch();
  document.addEventListener("astro:page-load", initializeDocsSearch);
</script>

<style>
  .docs-sidebar {
    position: sticky;
    top: 96px;
    max-height: calc(100vh - 116px);
    overflow-y: auto;
    padding: 10px 18px 40px 0;
    scrollbar-width: thin;
  }

  .docs-home {
    display: inline-block;
    margin-bottom: 34px;
    color: var(--site-ink);
    text-decoration: none;
    font-size: 15px;
    font-weight: 700;
  }

  .docs-search {
    margin-bottom: 28px;
  }

  .docs-search input {
    width: 100%;
    min-height: 38px;
    border: 1px solid var(--site-line);
    border-radius: 8px;
    padding: 0 11px;
    color: var(--site-ink);
    background: var(--site-surface);
    font-size: 12px;
  }

  [hidden] {
    display: none !important;
  }

  .mobile-docs-nav {
    display: none;
  }

  section + section {
    margin-top: 30px;
  }

  h2 {
    margin: 0 0 9px;
    color: var(--site-muted);
    font-family: var(--site-font-mono);
    font-size: 9px;
    font-weight: 750;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a:not(.docs-home) {
    display: block;
    border-radius: 7px;
    padding: 7px 10px;
    color: var(--site-body);
    text-decoration: none;
    font-size: 13px;
    line-height: 1.45;
  }

  a:not(.docs-home):hover {
    color: var(--site-ink);
    background: var(--site-canvas-soft);
  }

  a.active {
    color: var(--site-ink);
    background: var(--site-operational-soft);
    font-weight: 650;
  }

  @media (max-width: 980px) {
    .docs-sidebar {
      position: static;
      max-height: none;
      border-bottom: 1px solid var(--site-line);
      padding: 0 0 24px;
    }

    .docs-home {
      margin-bottom: 20px;
    }

    .docs-sidebar > section {
      display: none;
    }

    .docs-search {
      margin-bottom: 14px;
    }

    .mobile-docs-nav {
      display: block;
      border: 1px solid var(--site-line);
      border-radius: 9px;
      padding: 0 12px 12px;
      background: var(--site-surface);
    }

    .mobile-docs-nav summary {
      min-height: 44px;
      align-content: center;
      cursor: pointer;
      font-size: 13px;
      font-weight: 650;
    }

    .mobile-docs-nav section {
      margin-top: 18px;
    }
  }
</style>
