---
import contextImage from "../../assets/screenshots/context-and-approval.png";
import homeImage from "../../assets/screenshots/workbench-home.png";
import kairosImage from "../../assets/screenshots/kairos-runtime.png";
import usageImage from "../../assets/screenshots/usage-overview.png";
import { sitePath } from "../../lib/site-path";

const items = [
  {
    id: "context",
    label: "Context",
    kicker: "Context visibility",
    title: "上下文不再是黑箱",
    description: "按 System、Tools、Rules、Skills 与 Conversation 检查真实上下文组成，并观察 Token 占用。",
    image: contextImage,
    alt: "ActSpace Context 面板与上下文占用概览",
    href: "/docs/context/",
  },
  {
    id: "tools",
    label: "Tools",
    kicker: "Safe execution",
    title: "每一步执行都有边界",
    description: "Bash、文件编辑和权限请求以结构化状态呈现，等待批准时停在正确的位置。",
    image: homeImage,
    alt: "ActSpace 工作台中的工具执行过程",
    href: "/docs/tools-and-approvals/",
  },
  {
    id: "kairos",
    label: "Kairos",
    kicker: "Autonomous agent",
    title: "让 Agent 从被动变为主动",
    description: "Kairos 拥有独立 Prompt、记忆和节奏，在后台观察环境并留下可审查的运行轨迹。",
    image: kairosImage,
    alt: "ActSpace Kairos 运行轨迹和状态页面",
    href: "/docs/kairos/",
  },
  {
    id: "usage",
    label: "Usage",
    kicker: "Cost awareness",
    title: "成本与缓存清晰可见",
    description: "跨会话观察 Token、费用与缓存效率，让上下文工程真正建立在事实之上。",
    image: usageImage,
    alt: "ActSpace Usage 页面展示 Token、费用和缓存效率",
    href: "/docs/context/",
  },
];
---

<section class="showcase site-section" id="showcase" aria-labelledby="showcase-title" data-product-showcase>
  <div class="site-page">
    <header>
      <p class="site-kicker">Inside the runtime</p>
      <h2 id="showcase-title">把 Agent 的工作过程放到眼前。</h2>
    </header>

    <div class="showcase-grid">
      <div class="showcase-tabs" role="tablist" aria-label="产品能力截图">
        {items.map((item, index) => (
          <button
            type="button"
            role="tab"
            id={`tab-${item.id}`}
            aria-controls={`panel-${item.id}`}
            aria-selected={index === 0 ? "true" : "false"}
            tabindex={index === 0 ? "0" : "-1"}
            data-showcase-tab={item.id}
          >
            <span>{String(index + 1).padStart(2, "0")}</span>
            <strong>{item.label}</strong>
          </button>
        ))}
      </div>

      <div class="showcase-panels">
        {items.map((item, index) => (
          <article
            id={`panel-${item.id}`}
            role="tabpanel"
            aria-labelledby={`tab-${item.id}`}
            data-showcase-panel={item.id}
            data-active={index === 0 ? "true" : "false"}
          >
            <div class="panel-copy">
              <p>{item.kicker}</p>
              <h3>{item.title}</h3>
              <div>
                <span>{item.description}</span>
                <a href={sitePath(item.href)}>阅读指南 <span aria-hidden="true">→</span></a>
              </div>
            </div>
            <div class="panel-image">
              <img
                src={item.image.src}
                width={item.image.width}
                height={item.image.height}
                alt={item.alt}
                loading={index === 0 ? "eager" : "lazy"}
              />
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import { initProductShowcase } from "../../scripts/product-showcase";

  initProductShowcase();
</script>

<style>
  .showcase {
    color: var(--site-hero-ink);
    background: var(--site-canvas-soft);
  }

  header {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 40px;
    align-items: end;
    margin-bottom: 66px;
  }

  header :global(.site-kicker) {
    color: var(--site-muted);
  }

  header h2 {
    max-width: 900px;
    margin-bottom: 0;
    color: var(--site-ink);
    font-size: clamp(48px, 6vw, 76px);
    font-weight: 520;
    letter-spacing: -0.06em;
    line-height: 1.04;
  }

  .showcase-grid {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 34px;
  }

  .showcase-tabs {
    display: grid;
    align-content: start;
  }

  .showcase-tabs button {
    display: grid;
    min-height: 64px;
    grid-template-columns: 34px 1fr;
    align-items: center;
    border: 0;
    border-top: 1px solid var(--site-line);
    padding: 0 8px;
    color: var(--site-muted);
    background: transparent;
    cursor: pointer;
    text-align: left;
  }

  .showcase-tabs button:last-child {
    border-bottom: 1px solid var(--site-line);
  }

  .showcase-tabs button[aria-selected="true"] {
    color: var(--site-ink);
  }

  .showcase-tabs button span {
    font-family: var(--site-font-mono);
    font-size: 10px;
  }

  .showcase-tabs button strong {
    font-size: 15px;
  }

  article {
    color: var(--site-ink);
  }

  :global(html.js) article[data-active="false"] {
    display: none;
  }

  .panel-copy {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr 1.6fr;
    gap: 28px;
    align-items: start;
    margin-bottom: 28px;
  }

  .panel-copy > p {
    color: var(--site-muted);
    font-family: var(--site-font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .panel-copy h3 {
    margin-bottom: 0;
    font-size: clamp(28px, 3vw, 42px);
    font-weight: 560;
    letter-spacing: -0.045em;
    line-height: 1.08;
  }

  .panel-copy > div {
    color: var(--site-body);
    font-size: 15px;
    line-height: 1.7;
  }

  .panel-copy a {
    display: block;
    width: max-content;
    margin-top: 18px;
    color: var(--site-ink);
    text-decoration: none;
    font-weight: 650;
  }

  .panel-image {
    overflow: hidden;
    border: 1px solid var(--site-line);
    border-radius: 15px;
    padding: 7px;
    background: var(--site-surface);
    box-shadow: 0 24px 70px var(--site-shadow);
  }

  .panel-image :global(img) {
    width: 100%;
    aspect-ratio: 16 / 9.2;
    border-radius: 9px;
    object-fit: cover;
    object-position: top center;
  }

  @media (max-width: 900px) {
    header,
    .showcase-grid {
      grid-template-columns: 1fr;
    }

    .showcase-tabs {
      display: flex;
      overflow-x: auto;
    }

    .showcase-tabs button {
      min-width: 126px;
      border-bottom: 1px solid var(--site-line);
    }

    .panel-copy {
      grid-template-columns: 1fr 1.4fr;
    }

    .panel-copy > p {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 620px) {
    .panel-copy {
      grid-template-columns: 1fr;
    }

    .panel-copy > p {
      grid-column: auto;
    }
  }
</style>
