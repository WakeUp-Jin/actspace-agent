---
import { sitePath } from "../lib/site-path";
---

<footer class="site-footer">
  <div class="site-page footer-grid">
    <div class="footer-brand">
      <strong>ActSpace</strong>
      <p>一个可读、可改造、本地优先的 Agent Harness。</p>
    </div>
    <div>
      <span>产品</span>
      <a href={sitePath("/#principles")}>核心能力</a>
      <a href={sitePath("/#architecture")}>架构</a>
      <a href={sitePath("/docs/getting-started/")}>开始使用</a>
    </div>
    <div>
      <span>资源</span>
      <a href={sitePath("/docs/")}>文档</a>
      <a href={sitePath("/blog/")}>博客</a>
      <a href={sitePath("/updates/")}>更新</a>
    </div>
    <div>
      <span>社区</span>
      <a href="https://github.com/WakeUp-Jin/actspace-agent" target="_blank" rel="noreferrer noopener">GitHub ↗</a>
      <a href="https://github.com/WakeUp-Jin/actspace-agent/issues" target="_blank" rel="noreferrer noopener">Issue ↗</a>
      <a href="https://github.com/WakeUp-Jin/actspace-agent/blob/main/LICENSE" target="_blank" rel="noreferrer noopener">Apache-2.0 ↗</a>
    </div>
  </div>
  <div class="site-page footer-bottom">
    <span>© 2026 ActSpace</span>
    <span>Local-first · Open source</span>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--site-line);
    padding-block: 64px 28px;
    color: var(--site-body);
    background: var(--site-canvas-soft);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr repeat(3, 1fr);
    gap: 42px;
  }

  .footer-brand strong {
    color: var(--site-ink);
    font-size: 20px;
  }

  .footer-brand p {
    max-width: 320px;
    margin-top: 14px;
    line-height: 1.7;
  }

  .footer-grid > div:not(.footer-brand) {
    display: grid;
    align-content: start;
    gap: 12px;
    font-size: 13px;
  }

  .footer-grid span {
    color: var(--site-muted);
    font-size: 11px;
    font-weight: 650;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .footer-grid a {
    width: max-content;
    color: var(--site-body);
    text-decoration: none;
  }

  .footer-grid a:hover {
    color: var(--site-ink);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    border-top: 1px solid var(--site-line);
    margin-top: 52px;
    padding-top: 22px;
    color: var(--site-muted);
    font-family: var(--site-font-mono);
    font-size: 10px;
    letter-spacing: 0.06em;
  }

  @media (max-width: 760px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 460px) {
    .footer-bottom {
      align-items: flex-start;
      flex-direction: column;
      gap: 8px;
    }
  }
</style>
