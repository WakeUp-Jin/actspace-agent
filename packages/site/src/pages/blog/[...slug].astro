---
import { render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { blogHref, getPublicPosts, readingTime } from "../../lib/blog";
import { sitePath } from "../../lib/site-path";
import "../../styles/prose.css";

interface Props {
  entry: CollectionEntry<"blog">;
}

export async function getStaticPaths() {
  const posts = await getPublicPosts();
  return posts.map((entry) => ({
    params: { slug: blogHref(entry).replace(/^\/blog\//, "").replace(/\/$/, "") },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const minutes = readingTime(entry.body ?? "");
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : Astro.url.toString();
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: entry.data.publishedAt.toISOString(),
  dateModified: entry.data.updatedAt.toISOString(),
  author: entry.data.authors.map((name) => ({ "@type": "Person", name })),
  image: new URL(sitePath(entry.data.cover), Astro.site ?? Astro.url.origin).toString(),
  mainEntityOfPage: canonical,
});
---

<BaseLayout title={`${entry.data.title} — ActSpace 博客`} description={entry.data.description} image={entry.data.cover} type="article">
  <script slot="head" type="application/ld+json" is:inline set:html={jsonLd}></script>
  <main id="main-content">
    <header class="article-hero site-page">
      <a href={sitePath("/blog/")}>ActSpace 博客</a>
      <h1>{entry.data.title}</h1>
      <p>{entry.data.description}</p>
      <div class="article-meta">
        <span>{entry.data.authors.join("、")}</span>
        <time datetime={entry.data.publishedAt.toISOString()}>{entry.data.publishedAt.toLocaleDateString("zh-CN")}</time>
        <span>{minutes} 分钟阅读</span>
      </div>
    </header>

    <figure class="article-cover site-page">
      <img src={sitePath(entry.data.cover)} alt="" />
    </figure>

    <article class="docs-prose article-body site-reading">
      <Content />
    </article>
  </main>
</BaseLayout>

<style>
  .article-hero {
    padding-block: clamp(140px, 17vw, 240px) 66px;
    text-align: center;
  }

  .article-hero > a {
    color: var(--site-muted);
    text-decoration: none;
    font-family: var(--site-font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 1050px;
    margin: 34px auto 24px;
    font-family: var(--site-font-serif);
    font-size: clamp(58px, 8vw, 104px);
    font-weight: 500;
    letter-spacing: -0.07em;
    line-height: 1;
  }

  .article-hero > p {
    max-width: 720px;
    margin: 0 auto;
    color: var(--site-body);
    font-size: 18px;
    line-height: 1.75;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 18px;
    margin-top: 32px;
    color: var(--site-muted);
    font-family: var(--site-font-mono);
    font-size: 10px;
  }

  .article-cover {
    margin-top: 0;
    margin-bottom: clamp(70px, 10vw, 120px);
  }

  .article-cover img {
    width: 100%;
    border-radius: 18px;
  }

  .article-body {
    padding-bottom: clamp(100px, 14vw, 180px);
  }

  .article-body :global(p:first-child) {
    color: var(--site-ink);
    font-family: var(--site-font-serif);
    font-size: 24px;
    line-height: 1.7;
  }
</style>
