---
import workbenchImage from "../../assets/screenshots/workbench-home.png";
import DocsSidebar from "../../components/docs/DocsSidebar.astro";
import DocsTabs from "../../components/docs/DocsTabs.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { docsGroups, docsHref, getPublicDocs } from "../../lib/docs-navigation";
import { sitePath } from "../../lib/site-path";

const docs = await getPublicDocs();
const startCards = docs.filter((doc) => doc.data.group === "getting-started").slice(0, 3);
---

<BaseLayout title="ActSpace 文档" description="从安装到上下文、工具、Browser、Skills 与 Kairos，理解并改造 ActSpace。">
  <DocsTabs {docs} currentGroup="getting-started" />
  <main id="main-content" class="docs-grid site-page">
    <DocsSidebar {docs} currentGroup="getting-started" />
    <div class="docs-home-content">
      <header>
        <p class="site-kicker">Documentation</p>
        <h1>理解 Agent 的运行空间</h1>
        <p>从第一次运行开始，逐层认识模型、上下文、工具权限与主动 Agent。每篇文档都尽量指向真实仓库边界。</p>
      </header>

      <figure class="workbench-frame">
        <img src={workbenchImage.src} width={workbenchImage.width} height={workbenchImage.height} alt="ActSpace 桌面工作台主界面" />
        <figcaption>桌面工作台：会话、执行流与对象面板在同一空间中协作。</figcaption>
      </figure>

      <section class="start-section" aria-labelledby="start-title">
        <h2 id="start-title">从这里开始</h2>
        <div class="start-grid">
          {startCards.map((entry, index) => (
            <a href={sitePath(docsHref(entry))}>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <h3>{entry.data.title}</h3>
              <p>{entry.data.description}</p>
            </a>
          ))}
        </div>
      </section>

      <section class="docs-map" aria-labelledby="map-title">
        <p class="site-kicker">Explore the system</p>
        <h2 id="map-title">按系统边界阅读</h2>
        {docsGroups.filter((group) => group.id !== "getting-started").map((group) => (
          <div class="group-row">
            <h3>{group.label}</h3>
            <div>
              {docs.filter((entry) => entry.data.group === group.id).map((entry) => (
                <a href={sitePath(docsHref(entry))}>
                  <span>{entry.data.title}</span>
                  <small>{entry.data.description}</small>
                </a>
              ))}
            </div>
          </div>
        ))}
      </section>
    </div>
    <aside class="docs-start-aside" aria-label="快速入口">
      <p>快速入口</p>
      <a href={sitePath("/docs/getting-started/")}>安装与启动</a>
      <a href={sitePath("/docs/what-is-actspace/")}>ActSpace 是什么</a>
      <a href={sitePath("/docs/contributing/")}>参与开发</a>
    </aside>
  </main>
</BaseLayout>

<style>
  .docs-grid {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr) 170px;
    gap: clamp(28px, 3.5vw, 52px);
    padding-block: 50px 120px;
  }

  .docs-home-content {
    min-width: 0;
  }

  header {
    padding-block: clamp(24px, 4vw, 52px) 48px;
  }

  h1 {
    max-width: 820px;
    margin-block: 20px;
    font-family: var(--site-font-sans);
    font-size: clamp(44px, 5.5vw, 68px);
    font-weight: 520;
    letter-spacing: -0.055em;
    line-height: 1.06;
  }

  header > p:last-child {
    max-width: 720px;
    color: var(--site-body);
    font-size: 17px;
    line-height: 1.8;
  }

  .workbench-frame {
    margin: 0;
  }

  .workbench-frame img {
    width: 100%;
    border: 1px solid var(--site-line);
    border-radius: 16px;
    box-shadow: 0 30px 70px var(--site-shadow);
  }

  figcaption {
    margin-top: 12px;
    color: var(--site-muted);
    font-size: 12px;
  }

  .start-section,
  .docs-map {
    margin-top: 76px;
  }

  .start-section > h2,
  .docs-map > h2 {
    margin: 0 0 28px;
    font-size: clamp(34px, 4vw, 48px);
    font-weight: 550;
    letter-spacing: -0.045em;
  }

  .docs-map > h2 {
    margin-top: 20px;
  }

  .start-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }

  .start-grid a {
    min-height: 220px;
    border: 1px solid var(--site-line);
    border-radius: 12px;
    padding: 22px;
    background: var(--site-surface);
    text-decoration: none;
    transition: transform 180ms ease, border-color 180ms ease;
  }

  .start-grid a:hover {
    border-color: var(--site-line-strong);
    transform: translateY(-2px);
  }

  .start-grid span {
    color: var(--site-operational);
    font-family: var(--site-font-mono);
    font-size: 11px;
  }

  .start-grid h3 {
    margin: 50px 0 12px;
    font-size: 20px;
  }

  .start-grid p,
  .group-row small {
    color: var(--site-body);
    font-size: 13px;
    line-height: 1.6;
  }

  .group-row {
    display: grid;
    grid-template-columns: 170px minmax(0, 1fr);
    border-top: 1px solid var(--site-line);
    padding-block: 25px;
  }

  .group-row > h3 {
    font-size: 14px;
  }

  .group-row > div {
    display: grid;
    gap: 4px;
  }

  .group-row a {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    gap: 18px;
    padding: 9px;
    text-decoration: none;
  }

  .group-row a:hover {
    background: var(--site-canvas-soft);
  }

  .group-row span {
    font-size: 14px;
    font-weight: 650;
  }

  .docs-start-aside {
    position: sticky;
    top: 96px;
    align-self: start;
    display: grid;
    gap: 9px;
    padding: 10px 0 0 18px;
    border-left: 1px solid var(--site-line);
  }

  .docs-start-aside p {
    margin-bottom: 4px;
    font-size: 12px;
    font-weight: 700;
  }

  .docs-start-aside a {
    color: var(--site-muted);
    text-decoration: none;
    font-size: 12px;
  }

  .docs-start-aside a:hover {
    color: var(--site-ink);
  }

  @media (max-width: 1160px) {
    .docs-grid {
      grid-template-columns: 210px minmax(0, 1fr);
    }

    .docs-start-aside {
      display: none;
    }
  }

  @media (max-width: 760px) {
    .docs-grid {
      grid-template-columns: 1fr;
      padding-top: 28px;
    }
  }

  @media (max-width: 720px) {
    .start-grid,
    .group-row,
    .group-row a {
      grid-template-columns: 1fr;
    }

    .group-row > h3 {
      margin-bottom: 18px;
    }
  }
</style>
