---
import BaseLayout from "../layouts/BaseLayout.astro";
import { sitePath } from "../lib/site-path";
---

<BaseLayout title="页面不存在 — ActSpace" description="没有找到你访问的 ActSpace 页面。">
  <main id="main-content" class="site-reading">
    <p>404</p>
    <h1>这里没有可执行的任务</h1>
    <p>这个页面不存在，或者它已经移动到了新的位置。</p>
    <a href={sitePath("/")}>返回 ActSpace 首页</a>
  </main>
</BaseLayout>
