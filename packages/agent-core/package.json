{
  "name": "@actspace/agent-core",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@actspace/shared": "workspace:*",
    "@anthropic-ai/sdk": "^0.100.1",
    "@types/diff": "^8.0.0",
    "@vscode/ripgrep": "^1.18.0",
    "diff": "^9.0.0",
    "openai": "^6.39.0",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.3",
    "@types/turndown": "^5.0.6",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
