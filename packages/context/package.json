{
  "name": "@actspace/context",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js",
      "default": "./dist/manifest.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js",
      "default": "./dist/plugin.js"
    },
    "./codec": {
      "types": "./dist/codec.d.ts",
      "import": "./dist/codec.js",
      "default": "./dist/codec.js"
    },
    "./sources/conversation": {
      "types": "./dist/sources/conversation.d.ts",
      "import": "./dist/sources/conversation.js",
      "default": "./dist/sources/conversation.js"
    },
    "./sources/tools": {
      "types": "./dist/sources/tools.d.ts",
      "import": "./dist/sources/tools.js",
      "default": "./dist/sources/tools.js"
    },
    "./disclosure": {
      "types": "./dist/disclosure/plugin.d.ts",
      "import": "./dist/disclosure/plugin.js",
      "default": "./dist/disclosure/plugin.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --globals --passWithNoTests"
  },
  "dependencies": {
    "@actspace/cordis-adapter": "workspace:*",
    "@actspace/shared": "workspace:*",
    "@actspace/session-journal": "workspace:*",
    "@actspace/llm-service": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
