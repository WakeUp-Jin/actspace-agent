{
  "name": "@actspace/prompt",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js",
      "default": "./dist/manifest.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js",
      "default": "./dist/plugin.js"
    },
    "./source-support": {
      "types": "./dist/context-source-support.d.ts",
      "import": "./dist/context-source-support.js",
      "default": "./dist/context-source-support.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --globals --passWithNoTests"
  },
  "dependencies": {
    "@actspace/cordis-adapter": "workspace:*",
    "@actspace/context-engine": "workspace:*",
    "@actspace/agent": "workspace:*",
    "@actspace/scope": "workspace:*",
    "@actspace/shared": "workspace:*",
    "@actspace/session-journal": "workspace:*",
    "@actspace/llm-service": "workspace:*",
    "@actspace/skill": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
