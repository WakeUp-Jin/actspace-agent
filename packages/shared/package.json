{
  "name": "@actspace/shared",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    "./model-catalog-data": { "types": "./dist/generated/model-catalog.generated.d.ts", "import": "./dist/generated/model-catalog.generated.js", "require": "./dist/generated/model-catalog.generated.js", "default": "./dist/generated/model-catalog.generated.js" },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./session-selectors": {
      "types": "./dist/session-selectors.d.ts",
      "import": "./dist/session-selectors.js",
      "require": "./dist/session-selectors.js",
      "default": "./dist/session-selectors.js"
    },
    "./runtime-v2": {
      "types": "./dist/runtime-v2/index.d.ts",
      "import": "./dist/runtime-v2/index.js",
      "require": "./dist/runtime-v2/index.js",
      "default": "./dist/runtime-v2/index.js"
    },
    "./runtime-v2/projection": {
      "types": "./dist/runtime-v2/projection.d.ts",
      "import": "./dist/runtime-v2/projection.js",
      "require": "./dist/runtime-v2/projection.js",
      "default": "./dist/runtime-v2/projection.js"
    },
    "./runtime-v2/runtime": {
      "types": "./dist/runtime-v2/runtime.d.ts",
      "import": "./dist/runtime-v2/runtime.js",
      "require": "./dist/runtime-v2/runtime.js",
      "default": "./dist/runtime-v2/runtime.js"
    },
    "./runtime-v2/desktop-ipc": {
      "types": "./dist/runtime-v2/desktop-ipc.d.ts",
      "import": "./dist/runtime-v2/desktop-ipc.js",
      "require": "./dist/runtime-v2/desktop-ipc.js",
      "default": "./dist/runtime-v2/desktop-ipc.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
