{
  "name": "@actspace/runtime",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "cordis.yml",
    "loader.cjs",
    "loader.d.cts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./cordis": {
      "types": "./dist/cordis.d.ts",
      "import": "./dist/cordis.js",
      "default": "./dist/cordis.js"
    },
    "./session": {
      "types": "./dist/session/session-plugin.d.ts",
      "import": "./dist/session/session-plugin.js",
      "default": "./dist/session/session-plugin.js"
    },
    "./agent-factory": {
      "types": "./dist/harness/agent-factory-plugin.d.ts",
      "import": "./dist/harness/agent-factory-plugin.js",
      "default": "./dist/harness/agent-factory-plugin.js"
    },
    "./agent-runtime": {
      "types": "./dist/harness/agent-runtime-plugin.d.ts",
      "import": "./dist/harness/agent-runtime-plugin.js",
      "default": "./dist/harness/agent-runtime-plugin.js"
    },
    "./loader": {
      "types": "./loader.d.cts",
      "require": "./loader.cjs",
      "default": "./loader.cjs"
    },
    "./todo-projection": {
      "types": "./dist/session/todo-projection-plugin.d.ts",
      "import": "./dist/session/todo-projection-plugin.js",
      "default": "./dist/session/todo-projection-plugin.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.json && node scripts/build-default-harness.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --globals --passWithNoTests"
  },
  "dependencies": {
    "@actspace/agent-host": "workspace:*",
    "@actspace/english-learning": "workspace:*",
    "@actspace/side-chat": "workspace:*",
    "@actspace/boot": "workspace:*",
    "@actspace/bundle": "workspace:*",
    "@actspace/composition": "workspace:*",
    "@actspace/diagnostics": "workspace:*",
    "@actspace/cordis-adapter": "workspace:*",
    "@actspace/core-agent": "workspace:*",
    "@actspace/core-agent-loop": "workspace:*",
    "@actspace/core-scope": "workspace:*",
    "@actspace/session-journal": "workspace:*",
    "@actspace/session-projection": "workspace:*",
    "@actspace/session-projection-cache": "workspace:*",
    "@actspace/session-jsonl": "workspace:*",
    "@actspace/session-persistence": "workspace:*",
    "@actspace/session-checkpoint-policy": "workspace:*",
    "@actspace/llm-service": "workspace:*",
    "@actspace/llm-pi-ai": "workspace:*",
    "@actspace/context-engine": "workspace:*",
    "@actspace/context-system": "workspace:*",
    "@actspace/context-background-tasks": "workspace:*",
    "@actspace/context-runtime": "workspace:*",
    "@actspace/context-rules": "workspace:*",
    "@actspace/context-skills": "workspace:*",
    "@actspace/context-conversation": "workspace:*",
    "@actspace/context-tools": "workspace:*",
    "@actspace/context-disclosure": "workspace:*",
    "@actspace/context-compaction": "workspace:*",
    "@actspace/prompt": "workspace:*",
    "@actspace/tools-runtime": "workspace:*",
    "@actspace/tools-approval": "workspace:*",
    "@actspace/tools-todo-tools": "workspace:*",
    "@actspace/tools-browser-tools": "workspace:*",
    "@actspace/subagent": "workspace:*",
    "@actspace/headless": "workspace:*",
    "@actspace/desktop-app": "workspace:*",
    "@actspace/shared": "workspace:*",
    "@actspace/tools-filesystem-read": "workspace:*",
    "@actspace/tools-filesystem-search": "workspace:*",
    "@actspace/tools-filesystem-write": "workspace:*",
    "@actspace/tools-background-tasks": "workspace:*",
    "@actspace/tools-shell-tools": "workspace:*",
    "@actspace/tools-web-tools": "workspace:*",
    "@actspace/tools-image-generation": "workspace:*",
    "@actspace/tools-image-inspection": "workspace:*",
    "@actspace/agent-service": "workspace:*",
    "@actspace/background-tasks": "workspace:*",
    "@actspace/harness-control": "workspace:*",
    "@actspace/official-skills": "workspace:*",
    "@actspace/plugin-manager": "workspace:*",
    "@actspace/harness-hmr": "workspace:*",
    "@actspace/auto-review": "workspace:*",
    "@actspace/sandbox": "workspace:*",
    "@actspace/sandbox-nono": "workspace:*",
    "@actspace/sandbox-seatbelt": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "esbuild": "0.21.5",
    "@actspace/session-storage": "workspace:*"
  }
}
