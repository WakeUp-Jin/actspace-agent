diff --git a/dist/utils/actspace-wire-usage.js b/dist/utils/actspace-wire-usage.js
new file mode 100644
index 0000000000000000000000000000000000000000..76969423cb8682443fc1aab9ce9b9e886933a76e
--- /dev/null
+++ b/dist/utils/actspace-wire-usage.js
@@ -0,0 +1,22 @@
+// ActSpace's pinned integration metadata. SDK counters include synthetic zeroes;
+// these nullable counters retain only facts actually present on the wire.
+export function captureWireUsage(previous, raw, protocol) {
+    const usage = raw ?? {};
+    const completions = protocol === "openai-completions";
+    const anthropic = protocol === "anthropic-messages";
+    const inputDetails = usage[completions ? "prompt_tokens_details" : "input_tokens_details"];
+    const outputDetails = usage[completions ? "completion_tokens_details" : "output_tokens_details"];
+    const fields = {
+        input: usage[completions ? "prompt_tokens" : "input_tokens"],
+        output: usage[completions ? "completion_tokens" : "output_tokens"],
+        cacheRead: anthropic ? usage.cache_read_input_tokens : inputDetails?.cached_tokens ?? usage.prompt_cache_hit_tokens ?? usage.cached_tokens,
+        cacheWrite: anthropic ? usage.cache_creation_input_tokens : inputDetails?.cache_write_tokens ?? usage.prompt_cache_write_tokens,
+        reasoning: anthropic ? outputDetails?.thinking_tokens : outputDetails?.reasoning_tokens,
+    };
+    const result = { version: 1 };
+    for (const [key, value] of Object.entries(fields)) {
+        result[key] = typeof value === "number" && Number.isFinite(value) && value >= 0
+            ? value : previous?.[key] ?? null;
+    }
+    return result;
+}
