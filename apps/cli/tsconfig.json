{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "strict": true,
    "lib": [
      "ES2022"
    ],
    "baseUrl": ".",
    "paths": {
      "@actspace/shared/model-catalog-data": ["../../packages/shared/dist/generated/model-catalog.generated.d.ts"],
      "@actspace/shared": ["../../packages/shared/dist/index.d.ts"],
      "@actspace/shared/*": ["../../packages/shared/dist/*"],
      "@actspace/runtime": ["../../packages/runtime/dist/index.d.ts"],
      "@actspace/runtime/*": ["../../packages/runtime/dist/*"]
    },
    "rootDir": "src",
    "types": [
      "node"
    ],
    "outDir": "dist"
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/**/test"
  ]
}
