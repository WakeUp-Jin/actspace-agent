{
  "name": "@actspace/agent-cli",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "main": "dist/cli.js",
  "types": "dist/cli.d.ts",
  "bin": {
    "actspace-agent": "dist/cli.js"
  },
  "files": [
    "dist",
    "cordis.yml"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@actspace/agent-service": "workspace:*",
    "@actspace/agent-host": "workspace:*",
    "@actspace/runtime": "workspace:*",
    "@actspace/shared": "workspace:*",
    "@actspace/llm-service": "workspace:*",
    "@actspace/llm-pi-ai": "workspace:*",
    "@actspace/approval": "workspace:*",
    "@actspace/tool-runtime": "workspace:*",
    "@actspace/tool-fs-read": "workspace:*",
    "@actspace/tool-fs-search": "workspace:*",
    "@actspace/tool-fs-write": "workspace:*",
    "@actspace/tool-shell": "workspace:*",
    "@actspace/tool-web": "workspace:*",
    "@actspace/tool-image-generation": "workspace:*",
    "@actspace/tool-image-inspection": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
