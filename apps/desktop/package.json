{
  "name": "@actspace/desktop",
  "productName": "ActSpace",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "main": "dist-electron/main/index.js",
  "files": [
    "dist",
    "dist-electron"
  ],
  "scripts": {
    "dev": "node ../../scripts/desktop-dev.mjs",
    "dev:shared": "pnpm --filter @actspace/shared dev",
    "dev:deps": "tsc -b ../../tsconfig.desktop-deps.json --watch --preserveWatchOutput",
    "dev:client-bundle": "pnpm --filter @actspace/client exec esbuild src/sessions/index.ts --bundle --platform=neutral --format=cjs --external:@actspace/shared --external:@actspace/shared/* --outfile=dist/sessions.cjs --watch=forever",
    "dev:prompts": "pnpm --filter @actspace/english-learning exec node scripts/copy-prompts.mjs --watch",
    "dev:renderer": "vite",
    "dev:electron:build": "concurrently -k \"tsc -p tsconfig.electron.json --watch --preserveWatchOutput\" \"esbuild src/preload/index.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/preload/index.bundle.js --watch=forever\"",
    "dev:electron:run": "node ./scripts/dev-electron-run.mjs",
    "clean": "rm -rf dist dist-electron",
    "build:deps": "pnpm --filter @actspace/runtime... build && pnpm --filter @actspace/client build",
    "build:deps:dev": "node ../../scripts/generate-desktop-build-graph.mjs && tsc -b ../../tsconfig.desktop-deps.json && pnpm --filter @actspace/client exec esbuild src/sessions/index.ts --bundle --platform=neutral --format=cjs --external:@actspace/shared --external:@actspace/shared/* --outfile=dist/sessions.cjs && pnpm --filter @actspace/client exec esbuild src/host/index.ts --bundle --platform=neutral --format=cjs --external:@actspace/shared --external:@actspace/shared/* --outfile=dist/host.cjs && pnpm --filter @actspace/client exec esbuild src/live/index.ts --bundle --platform=neutral --format=cjs --external:@actspace/shared --external:@actspace/shared/* --outfile=dist/live.cjs && pnpm --filter @actspace/agent-host exec esbuild src/node-ports/index.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/node-ports.cjs && pnpm --filter @actspace/english-learning exec node scripts/copy-prompts.mjs && pnpm --filter @actspace/runtime exec node scripts/build-default-harness.mjs",
    "build": "pnpm run clean && pnpm run build:deps && pnpm build:renderer && pnpm build:electron",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json && esbuild src/preload/index.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/preload/index.bundle.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "test": "vitest run",
    "test:file-grant-scope-layout": "node scripts/test-file-grant-scope-layout.mjs",
    "test:composer-palette-layout": "node scripts/test-composer-palette-layout.mjs",
    "dev:host-bundles": "concurrently -k \"pnpm --filter @actspace/client exec esbuild src/host/index.ts --bundle --platform=neutral --format=cjs --external:@actspace/shared --external:@actspace/shared/* --outfile=dist/host.cjs --watch=forever\" \"pnpm --filter @actspace/client exec esbuild src/live/index.ts --bundle --platform=neutral --format=cjs --external:@actspace/shared --external:@actspace/shared/* --outfile=dist/live.cjs --watch=forever\" \"pnpm --filter @actspace/agent-host exec esbuild src/node-ports/index.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/node-ports.cjs --watch=forever\""
  },
  "dependencies": {
    "@actspace/agent-host": "workspace:*",
    "@actspace/approval": "workspace:*",
    "@actspace/client": "workspace:*",
    "@actspace/desktop-app": "workspace:*",
    "@actspace/english-learning": "workspace:*",
    "@actspace/llm-pi-ai": "workspace:*",
    "@actspace/llm-service": "workspace:*",
    "@actspace/official-skills": "workspace:*",
    "@actspace/runtime": "workspace:*",
    "@actspace/sandbox": "workspace:*",
    "@actspace/session-journal": "workspace:*",
    "@actspace/session-projection": "workspace:*",
    "@actspace/session-storage": "workspace:*",
    "@actspace/session-transcript": "workspace:*",
    "@actspace/shared": "workspace:*",
    "@actspace/side-chat": "workspace:*",
    "@actspace/subagent": "workspace:*",
    "@actspace/tool-browser": "workspace:*",
    "@actspace/tool-fs-read": "workspace:*",
    "@actspace/tool-fs-search": "workspace:*",
    "@actspace/tool-fs-write": "workspace:*",
    "@actspace/tool-image-generation": "workspace:*",
    "@actspace/tool-image-inspection": "workspace:*",
    "@actspace/tool-runtime": "workspace:*",
    "@actspace/tool-shell": "workspace:*",
    "@actspace/tool-web": "workspace:*",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@lezer/markdown": "1.8.1",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-virtual": "^3.14.9",
    "dompurify": "^3.4.17",
    "hast-util-to-jsx-runtime": "2.3.6",
    "highlight.js": "^11.11.1",
    "html-url-attributes": "3.0.1",
    "katex": "0.16.47",
    "lucide-react": "^1.16.0",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mermaid": "11.17.2",
    "micromark-extension-gfm": "3.0.0",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.0",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "1.25.12",
    "prosemirror-state": "1.4.4",
    "prosemirror-view": "1.42.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "7.0.1",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-breaks": "4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "unist-util-visit": "5.0.0",
    "vfile": "6.0.3",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@actspace/agent-loop": "workspace:*",
    "@actspace/context-conversation": "workspace:*",
    "@actspace/context-engine": "workspace:*",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.19.19",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.5.2",
    "concurrently": "^9.1.2",
    "electron": "^45.2.3",
    "esbuild": "^0.21.5",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.8.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "wait-on": "^8.0.3"
  }
}
