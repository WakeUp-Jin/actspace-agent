{
  "name": "@actspace/desktop",
  "productName": "ActSpace",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "main": "dist-electron/main/index.js",
  "files": [
    "dist",
    "dist-electron"
  ],
  "scripts": {
    "dev": "node ../../scripts/desktop-dev.mjs",
    "dev:shared": "pnpm --filter @actspace/shared dev",
    "dev:renderer": "vite",
    "dev:electron:build": "concurrently -k \"tsc -p tsconfig.electron.json --watch --preserveWatchOutput\" \"esbuild src/preload/index.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/preload/index.bundle.js --watch=forever\"",
    "dev:electron:run": "node ./scripts/dev-electron-run.mjs",
    "clean": "rm -rf dist dist-electron",
    "build:deps": "pnpm --filter @actspace/runtime... build && pnpm --filter @actspace/shared build && pnpm --filter @actspace/client build && pnpm --filter @actspace/session-projection build && pnpm --filter @actspace/runtime build && pnpm --filter @actspace/llm-service build && pnpm --filter @actspace/llm-pi-ai build && pnpm --filter @actspace/tools-runtime build && pnpm --filter @actspace/tools-core-tools build && pnpm --filter @actspace/tools-browser-tools build && pnpm --filter @actspace/session-journal build",
    "build": "pnpm run clean && pnpm run build:deps && pnpm build:renderer && pnpm build:electron",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json && esbuild src/preload/index.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/preload/index.bundle.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@actspace/client": "workspace:*",
    "@actspace/desktop-app": "workspace:*",
    "@actspace/english-learning": "workspace:*",
    "@actspace/llm-pi-ai": "workspace:*",
    "@actspace/llm-service": "workspace:*",
    "@actspace/runtime": "workspace:*",
    "@actspace/session-journal": "workspace:*",
    "@actspace/session-projection": "workspace:*",
    "@actspace/shared": "workspace:*",
    "@actspace/tools-approval": "workspace:*",
    "@actspace/tools-browser-tools": "workspace:*",
    "@actspace/tools-core-tools": "workspace:*",
    "@actspace/tools-runtime": "workspace:*",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-virtual": "^3.14.9",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.16.0",
    "node-pty": "1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.30",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.5.2",
    "concurrently": "^9.1.2",
    "electron": "^39.8.3",
    "esbuild": "^0.21.5",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.8.3",
    "vite": "^5.4.19",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.3",
    "@actspace/core-agent-loop": "workspace:*"
  }
}
