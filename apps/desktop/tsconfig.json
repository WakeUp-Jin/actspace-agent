{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": false,
    "lib": [
      "DOM",
      "ES2022"
    ],
    "baseUrl": ".",
    "paths": {
      "@actspace/shared": ["../../packages/shared/dist/index.d.ts"],
      "@actspace/shared/*": ["../../packages/shared/dist/*"]
    },
    "types": [
      "vite/client",
      "vitest/globals"
    ],
    "noEmit": true
  },
  "include": [
    "src/renderer",
    "src/global.d.ts",
    "vite.config.mts"
  ]
}
