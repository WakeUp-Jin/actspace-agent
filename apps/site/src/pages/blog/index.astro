---
import type {ImageMetadata} from 'astro';
import {Image} from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {blogHref,getPublicPosts} from '../../lib/blog';
import {coverColors,presentationFor} from '../../lib/blog-presentation';
import {spaceCjk} from '../../lib/markdown/cjk-spacing.mjs';
import {sitePath} from '../../lib/site-path';
import '../../styles/blog.css';
const posts=await getPublicPosts();
const categoryOf=(post:(typeof posts)[number])=>presentationFor(post.id)?.category??post.data.tags[0];
const categories=[...new Set(posts.map(categoryOf))];
const images=import.meta.glob<{default:ImageMetadata}>('../../assets/blog/covers/*.png',{eager:true});
---
<BaseLayout title="ActSpace 博客" description="关于 Agent 的设计、工程与实践。">
<main id="main-content" class="blog-page">
<header class="blog-head">
<h1>博客</h1>
<div class="blog-filters" role="group" aria-label="按分类筛选">
<button type="button" data-category="" aria-pressed="true">全部</button>
{categories.map(category=><button type="button" data-category={category} aria-pressed="false">{category}</button>)}
</div>
</header>
<div class="blog-grid">
{posts.map((post,index)=>{
  const meta=presentationFor(post.id);
  const cover=meta?.cover??'01';
  const colors=coverColors[cover];
  const image=images[`../../assets/blog/covers/character-${cover}.png`]?.default;
  const date=post.data.publishedAt.toISOString().slice(0,10);
  return <a class:list={['blog-item',{'is-lead':index===0}]} href={sitePath(blogHref(post))} data-category={categoryOf(post)}>
<div class:list={['blog-tile',{'is-light':colors.light}]} style={`--tile-bg:${colors.bg};--tile-ink:${colors.ink}`}>
{image&&<Image class="blog-tile-character" src={image} alt="" format="webp" quality={90} widths={[480,800,1254]} sizes="(max-width: 640px) 100vw, (max-width: 1000px) 50vw, 520px" loading={index<3?'eager':'lazy'}/>}
<div class="blog-tile-top"><span>{categoryOf(post)}</span><time datetime={date}>{date.slice(5)}</time></div>
<div class="blog-tile-key" aria-hidden="true">{meta?.key??''}</div>
</div>
<h2>{spaceCjk(post.data.title)}</h2>
</a>})}
</div>
</main>
</BaseLayout>
<script>
// 分类单选；?category= 可直达，切换时同步地址。可见的第一篇做头条。
const buttons=[...document.querySelectorAll<HTMLButtonElement>('.blog-filters button')];
const items=[...document.querySelectorAll<HTMLElement>('.blog-item')];
function select(category:string){
  buttons.forEach(button=>button.setAttribute('aria-pressed',String(button.dataset.category===category)));
  let lead=true;
  items.forEach(item=>{item.hidden=category!==''&&item.dataset.category!==category;item.classList.toggle('is-lead',!item.hidden&&lead);if(!item.hidden)lead=false;});
}
buttons.forEach(button=>button.addEventListener('click',()=>{
  const category=button.dataset.category??'';
  select(category);
  const url=new URL(location.href);
  if(category)url.searchParams.set('category',category);else url.searchParams.delete('category');
  history.replaceState(null,'',url);
}));
const initial=new URLSearchParams(location.search).get('category');
if(initial&&buttons.some(button=>button.dataset.category===initial))select(initial);
</script>
