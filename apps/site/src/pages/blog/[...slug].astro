---
import { render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { blogHref, getPublicPosts, readingTime } from "../../lib/blog";
import { sitePath } from "../../lib/site-path";
import "../../styles/prose.css";

interface Props {
  entry: CollectionEntry<"blog">;
}

export async function getStaticPaths() {
  const posts = await getPublicPosts();
  return posts.map((entry) => ({
    params: { slug: blogHref(entry).replace(/^\/blog\//, "").replace(/\/$/, "") },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const minutes = readingTime(entry.body ?? "");
const publishedAt = entry.data.publishedAt.toLocaleDateString("zh-CN", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : Astro.url.toString();
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: entry.data.publishedAt.toISOString(),
  dateModified: entry.data.updatedAt.toISOString(),
  author: entry.data.authors.map((name) => ({ "@type": "Person", name })),
  image: new URL(sitePath(entry.data.cover), Astro.site ?? Astro.url.origin).toString(),
  mainEntityOfPage: canonical,
});

import {presentationFor} from "../../lib/blog-presentation";
import "../../styles/editorial.css";
const category=presentationFor(entry.id)?.category??entry.data.tags[0];
---
<BaseLayout title={`${entry.data.title} — ActSpace 博客`} description={entry.data.description} image={entry.data.cover} type="article">
<script slot="head" type="application/ld+json" is:inline set:html={jsonLd}>
</script>
<main id="main-content">
<article class="post-reading">
<nav class="post-breadcrumb" aria-label="面包屑">
<a href={sitePath('/blog/')}>博客</a>
<span>/</span>
<span>{entry.data.title}</span>
</nav>
<div class="post-intro">
<header>
<h1>{entry.data.title}</h1>
<p class="reading-lead">{entry.data.description}</p>
</header>
<aside class="post-meta" aria-label="文章信息">
<div>
<span>分类</span>
<a href={`${sitePath('/blog/')}?category=${encodeURIComponent(category)}`}>{category}</a>
</div>
<div>
<span>产品</span>
<a href={sitePath('/')}>ActSpace</a>
</div>
<div>
<span>发布日期</span>
<time datetime={entry.data.publishedAt.toISOString()}>{publishedAt}</time>
</div>
<div>
<span>预计阅读</span>
<p>{minutes} 分钟</p>
</div>
<div>
<span>分享</span>
<button id="copy-link" aria-live="polite">复制链接 ↗</button>
</div>
</aside>
</div>
<div class="reading-body docs-prose">
<Content/>
</div>
<nav class="reading-next">
<a href={sitePath('/blog/')}>← 返回博客</a>
<a href={sitePath('/docs/')}>探索文档 →</a>
</nav>
</article>
</main>
</BaseLayout>
<script>document.querySelector<HTMLButtonElement>('#copy-link')?.addEventListener('click',async event=>{const button=event.currentTarget as HTMLButtonElement;try{await navigator.clipboard.writeText(location.href);button.textContent='链接已复制'}catch{button.textContent='复制失败，请复制地址栏'}setTimeout(()=>button.textContent='复制链接 ↗',2200)});</script>
