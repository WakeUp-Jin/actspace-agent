---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/home/Hero.astro";
import TodaySection from "../components/home/TodaySection.astro";
import FeatureShot from "../components/home/FeatureShot.astro";
import DirectionStrip from "../components/home/DirectionStrip.astro";
import HarnessBlock from "../components/home/HarnessBlock.astro";
import ClosingSection from "../components/home/ClosingSection.astro";
import { approvalPoints, contextPoints, deliverablePoints, spacePoints, trajectoryPoints } from "../lib/home-features";
import { sitePath } from "../lib/site-path";
import deliverablesShot from "../assets/screenshots/home/turn-deliverables.png";
import trajectoryShot from "../assets/screenshots/home/trajectory.png";
import approvalShot from "../assets/screenshots/home/approval.png";
import contextShot from "../assets/screenshots/home/context-panel.png";
import spaceShot from "../assets/screenshots/home/space.png";
import "../styles/home.css";
// 截图都来自桌面端的浏览器演示模式（示例数据），重拍方法见 apps/site/SCREENSHOTS.md。
const productNote = "产品界面 · 示例数据";
---
<BaseLayout title="ActSpace — 会自我进化的 Agent 运行空间" description="唯变所适。先把本地 Coding Agent 做扎实，接下来会在不同场景里长成各自专业的 Actor。">
  <main id="main-content" class="home">
    <Hero/>
    <TodaySection/>
    <FeatureShot
      id="deliverables" status="live" tag="编辑与 Review" stage="mint"
      title="改动一眼看清"
      description="每轮回复末尾列出改了哪些文件、生成了什么，点开就能审阅。"
      points={deliverablePoints} image={deliverablesShot} windowTitle="ActSpace · 整理季度报告" note={productNote}
      alt="ActSpace 界面（示例数据）：回复末尾的改动卡列出 6 个文件的增删行数，下方是 summary.csv、report.md 等交付文件，最后一轮显示用量 10.7K tok"
      link={{ href: sitePath("/docs/review/"), label: "了解审阅与改动" }}
    />
    <FeatureShot
      id="trajectory" status="live" tag="执行轨迹" stage="slate" reverse
      title="每一步都能回放"
      description="读了什么、跑了什么、哪里失败，都按时间排好，不用翻聊天记录。"
      points={trajectoryPoints} image={trajectoryShot} windowTitle="ActSpace · 执行轨迹" note={productNote}
      alt="ActSpace 界面（示例数据）：执行轨迹顶部是按轮次排开的输入、模型、工具时间线，下面逐行列出用户、助手和工具调用，其中一条检查命令失败、一条被用户停止"
      link={{ href: sitePath("/docs/agent-turn/#记录与观察"), label: "了解一次 Agent 执行" }}
    />
    <FeatureShot
      id="approvals" status="live" tag="审批策略" stage="peach" natural
      title="动手前先问你"
      description="会改变环境的操作先停下来等你确认，放行到什么程度由你定。"
      points={approvalPoints} image={approvalShot} windowTitle="ActSpace · 清理构建产物" note={productNote}
      alt="ActSpace 界面（示例数据）：Agent 请求运行 pnpm test，审批卡标着真实环境，右侧是拒绝、本会话允许 pnpm 和运行三个按钮；下方打开的权限模式菜单里有自动和完全权限两项"
      link={{ href: sitePath("/docs/tools-and-approvals/"), label: "了解工具与审批" }}
    />
    <DirectionStrip/>
    <FeatureShot
      id="context" status="live" tag="上下文管理引擎" stage="mint" portrait
      title="长任务不失忆"
      description="旧历史压成结构化摘要，用到的内容才放进来，每次请求带了什么都看得到。"
      points={contextPoints} image={contextShot} windowTitle="上下文面板" note={productNote}
      alt="ActSpace 上下文面板（示例数据）：当前约 72.2K / 200K tokens，按类别拆分的明细，带一次自动压缩的趋势图，以及 Skill 注入、压缩等上下文事件"
      link={{ href: sitePath("/docs/context/"), label: "了解上下文管理" }}
    />
    <HarnessBlock/>
    <FeatureShot
      id="space" status="wip" tag="Actor 与 Space" stage="slate"
      title="几位 Actor，一起解决问题"
      description="Agent 在场景里用久了，会长成有能力、有记忆的 Actor。遇到大问题，Space 把它们聚到一起，你只和协调 Agent 说。"
      points={spacePoints} image={spaceShot} windowTitle="ActSpace · Space 支付链路提速" note="开发中演示 · 示例数据"
      alt="ActSpace 开发中演示（示例数据）：Space「支付链路提速」里，协调 Agent 把任务分给性能分析、后端、前端等 Actor，右侧按等你决定、工作中、有结果、空闲分组"
      link={{ href: sitePath("/docs/what-is-actspace/#产品理念"), label: "阅读产品理念" }}
    />
    <ClosingSection/>
  </main>
</BaseLayout>
<script>
import { initializeLoops } from "../scripts/home-loop";
import { initializeFocusStages } from "../scripts/home-focus";
initializeLoops();
initializeFocusStages();
</script>
