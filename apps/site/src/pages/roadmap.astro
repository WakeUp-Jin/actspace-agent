---
import BaseLayout from "../layouts/BaseLayout.astro";
import { loadRoadmap } from "../lib/roadmap";
import { directions, statusLabel } from "../lib/home-features";
import { sitePath } from "../lib/site-path";

const roadmap = await loadRoadmap();
const openCount = roadmap.filter((item) => item.status === "open").length;
const completedCount = roadmap.length - openCount;
---

<BaseLayout
  title="ActSpace 开发计划"
  description="查看 ActSpace 已经完成和计划开发的功能。"
>
  <main id="main-content" class="roadmap-page" data-roadmap>
    <section class="roadmap-hero">
      <div class="site-page roadmap-heading">
        <div class="roadmap-intro">
          <p class="eyebrow">公开开发进度</p>
          <h1>开发计划</h1>
          <p>ActSpace 沿着三个方向迭代：先让长任务不失忆，再让 Harness 按问题进化，最后让 Actor 在 Space 里协作。下面是每个方向走到了哪里，以及完整的功能清单。</p>
        </div>

        <div class="status-summary" aria-label="开发计划状态统计">
          <div class="status-stat">
            <span class="status-circle" aria-hidden="true"></span>
            <div><strong>{openCount}</strong><span>未完成</span></div>
          </div>
          <div class="status-stat status-stat--completed">
            <span class="status-circle" aria-hidden="true"></span>
            <div><strong>{completedCount}</strong><span>已完成</span></div>
          </div>
        </div>
      </div>
    </section>

    <section class="site-page roadmap-directions" aria-label="三个方向">
      <ol>
        {directions.map((item, index) => (
          <li>
            <a href={sitePath(`/#${item.id}`)}>
              <span class="direction-head">
                <span class="direction-index">0{index + 1}</span>
                <span class:list={["direction-pill", item.status]}>{statusLabel[item.status]}</span>
              </span>
              <strong>{item.name}</strong>
              <span class="direction-summary">{item.summary}</span>
              <span class="direction-row"><b>已完成</b>{item.done}</span>
              <span class="direction-row"><b>下一步</b>{item.next}</span>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <section class="site-page roadmap-checklist" aria-label="开发计划清单">
      <div class="roadmap-tabs" role="tablist" aria-label="筛选开发计划状态">
        <button
          id="roadmap-tab-open"
          class="roadmap-tab"
          type="button"
          role="tab"
          aria-selected="true"
          aria-controls="roadmap-list"
          data-roadmap-tab="open"
        >未完成</button>
        <button
          id="roadmap-tab-completed"
          class="roadmap-tab"
          type="button"
          role="tab"
          aria-selected="false"
          aria-controls="roadmap-list"
          data-roadmap-tab="completed"
        >已完成</button>
      </div>

      <ul
        class="roadmap-list"
        id="roadmap-list"
        role="tabpanel"
        aria-labelledby="roadmap-tab-open"
        data-roadmap-list
      >
        {roadmap.map((item) => (
          <li class:list={["roadmap-item", { "roadmap-item--completed": item.status === "completed" }]} data-status={item.status}>
            <span class="item-circle" aria-hidden="true"></span>
            <span class="item-title">{item.title}</span>
            {item.completedAt && (
              <time class="completed-at" datetime={item.completedAt}>完成于 {item.completedAt}</time>
            )}
          </li>
        ))}
      </ul>

      <div class="load-more-wrap" data-load-wrap>
        <button class="load-more" type="button" data-load-more>
          <span data-load-label>加载更多</span>
        </button>
      </div>
      <p class="sr-only" aria-live="polite" data-roadmap-status></p>
    </section>
  </main>
</BaseLayout>

<script>
  import { initRoadmap } from "../scripts/roadmap";

  initRoadmap();
</script>

<style>
  .roadmap-page {
    min-height: 72vh;
  }

  .roadmap-hero {
    padding-block: clamp(56px, 7vw, 96px) clamp(44px, 5vw, 64px);
  }

  .roadmap-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    align-items: end;
    gap: 64px;
  }

  .roadmap-intro h1 {
    margin: 14px 0 0;
    font-family: var(--site-font-display);
    font-size: clamp(40px, 5vw, 56px);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.1;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    color: var(--site-muted);
    font-size: 13px;
  }

  .eyebrow::before {
    width: 22px;
    height: 1px;
    background: currentColor;
    content: "";
  }

  .roadmap-directions {
    padding-bottom: clamp(56px, 7vw, 88px);
  }

  .roadmap-directions ol {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .roadmap-directions a {
    display: flex;
    height: 100%;
    flex-direction: column;
    gap: 10px;
    padding: 24px 24px 22px;
    border: 1px solid var(--site-line);
    border-radius: 18px;
    color: inherit;
    background: var(--site-paper);
    text-decoration: none;
    transition: border-color 160ms ease, transform 160ms ease;
  }

  .roadmap-directions a:hover {
    border-color: var(--site-line-strong);
    transform: translateY(-2px);
  }

  .direction-head {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .direction-index {
    color: var(--site-muted);
    font-family: var(--site-font-mono);
    font-size: 12px;
  }

  .direction-pill {
    padding: 2px 9px;
    border-radius: 999px;
    font-size: 12px;
    line-height: 1.5;
  }

  .direction-pill.live { color: var(--site-live); background: var(--site-live-soft); }
  .direction-pill.wip { color: var(--site-wip); background: var(--site-wip-soft); }

  .roadmap-directions strong {
    margin-top: 6px;
    font-family: var(--site-font-display);
    font-size: 24px;
    font-weight: 500;
  }

  .direction-summary {
    color: var(--site-body);
    font-size: 14px;
    line-height: 1.7;
  }

  .direction-row {
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr);
    gap: 8px;
    padding-top: 10px;
    border-top: 1px solid var(--site-line);
    color: var(--site-ink);
    font-size: 13px;
    line-height: 1.6;
  }

  .direction-summary + .direction-row {
    margin-top: auto;
  }

  .direction-row b {
    color: var(--site-muted);
    font-weight: 500;
  }

  .roadmap-intro p {
    max-width: 720px;
    margin: 24px 0 0;
    color: var(--site-body);
    font-size: 16px;
    line-height: 1.8;
  }

  .status-summary {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-left: 1px solid var(--site-line);
  }

  .status-stat {
    display: grid;
    grid-template-columns: 18px auto;
    align-items: center;
    gap: 11px;
    padding-left: 28px;
  }

  .status-stat + .status-stat {
    border-left: 1px solid var(--site-line);
    margin-left: 24px;
  }

  .status-circle,
  .item-circle {
    position: relative;
    border: 1.5px solid var(--site-line-strong);
    border-radius: 50%;
    background: var(--site-paper);
  }

  .status-circle {
    width: 15px;
    height: 15px;
  }

  .status-stat--completed .status-circle,
  .roadmap-item--completed .item-circle {
    border-color: var(--site-live);
    background: var(--site-live);
  }

  .status-stat--completed .status-circle::after,
  .roadmap-item--completed .item-circle::after {
    position: absolute;
    border-right: 1.5px solid var(--site-paper);
    border-bottom: 1.5px solid var(--site-paper);
    content: "";
    transform: rotate(43deg);
  }

  .status-stat--completed .status-circle::after {
    top: 2px;
    left: 4px;
    width: 4px;
    height: 7px;
  }

  .status-stat strong {
    display: block;
    font-family: var(--site-font-display);
    font-size: 26px;
    font-weight: 500;
  }

  .status-stat div span {
    display: block;
    margin-top: 3px;
    color: var(--site-muted);
    font-size: 11px;
  }

  .roadmap-checklist {
    padding-bottom: clamp(112px, 14vw, 190px);
  }

  .roadmap-tabs {
    display: flex;
    gap: 30px;
    border-bottom: 1px solid var(--site-line-strong);
  }

  .roadmap-tab {
    position: relative;
    padding: 17px 0 15px;
    border: 0;
    color: var(--site-muted);
    background: transparent;
    cursor: pointer;
    font-size: 13px;
    font-weight: 640;
  }

  .roadmap-tab:hover,
  .roadmap-tab[aria-selected="true"] {
    color: var(--site-ink);
  }

  .roadmap-tab[aria-selected="true"]::after {
    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;
    height: 2px;
    background: var(--site-ink);
    content: "";
  }

  .roadmap-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .roadmap-item {
    display: grid;
    min-height: 60px;
    grid-template-columns: 26px minmax(0, 1fr) auto;
    align-items: center;
    gap: 14px;
    border-bottom: 1px solid var(--site-line);
  }

  .roadmap-item[hidden],
  .load-more-wrap[hidden] {
    display: none;
  }

  :global(html.js) .roadmap-list:not([data-roadmap-ready]) .roadmap-item[data-status="completed"],
  :global(html.js) .roadmap-list:not([data-roadmap-ready]) .roadmap-item[data-status="open"]:nth-child(n + 7) {
    display: none;
  }

  .item-circle {
    width: 16px;
    height: 16px;
  }

  .roadmap-item--completed .item-circle::after {
    top: 1px;
    left: 4px;
    width: 4px;
    height: 8px;
  }

  .item-title {
    font-size: 16px;
    font-weight: 640;
    letter-spacing: -0.018em;
    line-height: 1.45;
  }

  .roadmap-item--completed .item-title {
    color: var(--site-muted);
    text-decoration: line-through;
    text-decoration-color: var(--site-line-strong);
    text-decoration-thickness: 1px;
  }

  .completed-at {
    color: var(--site-muted);
    font-family: var(--site-font-mono);
    font-size: 11px;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }

  .load-more-wrap {
    display: flex;
    justify-content: center;
    padding-top: 28px;
  }

  .load-more {
    min-width: 184px;
    padding: 11px 18px;
    border: 1px solid var(--site-line);
    border-radius: 999px;
    color: var(--site-body);
    background: var(--site-paper);
    cursor: pointer;
    font-size: 12px;
    font-weight: 640;
    transition: border-color 160ms ease, color 160ms ease, transform 160ms ease;
  }

  .load-more:hover {
    border-color: var(--site-line-strong);
    color: var(--site-ink);
    transform: translateY(-1px);
  }

  @media (max-width: 760px) {
    .roadmap-hero {
      padding-block: 58px 42px;
    }

    .roadmap-heading {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .roadmap-intro h1 {
      font-size: 40px;
    }

    .roadmap-directions ol {
      grid-template-columns: 1fr;
    }

    .status-summary {
      max-width: 360px;
      border-left: 0;
    }

    .status-stat {
      padding-left: 0;
    }

    .roadmap-item {
      min-height: 58px;
    }
  }

  @media (max-width: 420px) {
    .status-stat + .status-stat {
      margin-left: 16px;
      padding-left: 16px;
    }

    .roadmap-tabs {
      gap: 24px;
    }

    .roadmap-item {
      grid-template-columns: 24px minmax(0, 1fr);
      padding-block: 13px;
    }

    .completed-at {
      grid-column: 2;
      margin-top: -8px;
    }
  }
</style>
