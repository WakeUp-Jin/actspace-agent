---
import DocsLayout from '../../layouts/DocsLayout.astro';
import {getPublicDocs,docsHref,type DocsEntry} from '../../lib/docs-navigation';
interface Props {entry:DocsEntry;}
export async function getStaticPaths(){return (await getPublicDocs()).map(entry=>({params:{slug:docsHref(entry).replace(/^\/docs\//,'').replace(/\/$/,'')},props:{entry}}));}
const {entry}=Astro.props;
---
<DocsLayout {entry}/>
