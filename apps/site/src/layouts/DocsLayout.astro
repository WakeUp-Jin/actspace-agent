---
import {render} from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import {getPublicDocs,docsGroups,docsHref,type DocsEntry} from '../lib/docs-navigation';
import {readingTime} from '../lib/blog';
import {sitePath} from '../lib/site-path';
import '../styles/docs.css';
interface Props {entry:DocsEntry; welcome?:boolean;}
const {entry,welcome=false}=Astro.props;
const docs=await getPublicDocs();const {Content,headings}=await render(entry);
const title=welcome?'ActSpace 文档':entry.data.title;
const index=docs.findIndex(doc=>doc.id===entry.id);
const previous=docs[index-1];const next=docs[index+1];
const minutes=readingTime(entry.body??'');
const updated=entry.data.updatedAt.toISOString().slice(0,10);
const editUrl=`https://github.com/WakeUp-Jin/actspace-agent/edit/main/apps/site/${entry.filePath}`;
---
<BaseLayout title={`${title} — ActSpace`} description={entry.data.description}>
<main id="main-content" class="docs-layout">
<aside class="docs-sidebar">
<details open>
<summary>文档目录<span aria-hidden="true" class="directory-chevron"></span></summary>
<nav aria-label="文档目录">{docsGroups.map(group=>
<div class="docs-group">
<p>{group.label}</p>{docs.filter(doc=>doc.data.group===group.id).map(doc=>
<a href={sitePath(docsHref(doc))} aria-current={doc.id===entry.id?'page':undefined}>{doc.data.title}</a>)}</div>)}</nav>
</details>
</aside>
<article class="docs-article">
<header class="docs-head">
<p class="docs-crumb"><span>文档</span><span>/</span><span>{docsGroups.find(g=>g.id===entry.data.group)?.label}</span></p>
<h1>{title}</h1>
<p class="docs-lead">{entry.data.description}</p>
<div class="docs-meta">
<span>更新于 <time datetime={updated}>{updated}</time></span>
<span>约 {minutes} 分钟</span>
<button class="page-copy-button" type="button" data-copy-page aria-live="polite">复制页面</button>
</div>
</header>
<div class="prose docs-prose">
<Content/>
</div>
<nav class="docs-pager" aria-label="上一篇与下一篇">
{previous&&<a href={sitePath(docsHref(previous))}><small>← 上一篇</small><b>{previous.data.title}</b></a>}
{next&&<a class="is-next" href={sitePath(docsHref(next))}><small>下一篇 →</small><b>{next.data.title}</b></a>}
</nav>
<p class="docs-foot"><a href={editUrl} target="_blank" rel="noreferrer noopener">在 GitHub 上编辑 ↗</a></p>
</article>
<aside class="docs-toc">
<p>本页内容</p>
<nav aria-label="本页目录">{headings.filter(h=>h.depth===2||h.depth===3).map(h=>
<a href={`#${h.slug}`} class:list={{nested:h.depth===3}} data-toc-link>{h.text}</a>)}</nav>
</aside>
</main>
</BaseLayout>
<script>
import {initializeCodeCopy} from '../scripts/code-copy';
initializeCodeCopy();
const directory=document.querySelector<HTMLDetailsElement>('.docs-sidebar details');
const narrowDirectory=matchMedia('(max-width:760px)');
const syncDirectory=()=>{if(directory)directory.open=!narrowDirectory.matches;};
syncDirectory();
narrowDirectory.addEventListener('change',syncDirectory);
document.querySelector<HTMLButtonElement>('[data-copy-page]')?.addEventListener('click',async event=>{const button=event.currentTarget as HTMLButtonElement;try{await navigator.clipboard.writeText(document.querySelector<HTMLElement>('.docs-article')?.innerText??'');button.textContent='已复制'}catch{button.textContent='复制失败，请手动复制'}setTimeout(()=>button.textContent='复制页面',2200)});
// 页内目录：当前所在小节加深并显示紫色左线。
const links=[...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
const targets=links.map(link=>document.getElementById(decodeURIComponent(link.hash.slice(1)))).filter((el):el is HTMLElement=>el!==null);
let frame=0;
const spy=()=>{frame=0;let current=targets[0];for(const target of targets){if(target.getBoundingClientRect().top<140)current=target;}links.forEach(link=>link.classList.toggle('is-active',decodeURIComponent(link.hash.slice(1))===current?.id));};
if(targets.length){addEventListener('scroll',()=>{frame||=requestAnimationFrame(spy)},{passive:true});spy();}
</script>
