---
import "../styles/global.css";
import "../styles/media.css";
import MediaViewer from "../components/MediaViewer.astro";
import SeoHead from "../components/SeoHead.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";

interface Props {
  title: string;
  description: string;
  heroHeader?: boolean;
  image?: string;
  type?: "website" | "article";
}

const { title, description, heroHeader = false, image, type = "website" } = Astro.props;
---

<!doctype html>
<html lang="zh-CN" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}brand/favicon.svg`} />
    <SeoHead {title} {description} {image} {type} />
    <slot name="head" />

  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    <SiteHeader hero={heroHeader} />
    <slot />
    <MediaViewer/>
    {!Astro.url.pathname.includes('/docs/') && <SiteFooter />}
  </body>
</html>
