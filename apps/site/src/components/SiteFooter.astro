---
import {sitePath} from "../lib/site-path";
import { Image } from 'astro:assets';
import logo from '../assets/brand/actspace-logo.png';
---
<footer class="site-footer">
<div class="wrap footer-inner">
<a class="brand" href={sitePath('/')}>
<Image class="brand-logo" src={logo} alt="" width={150} format="webp" quality={85} widths={[50, 100, 150]} sizes="50px" loading="lazy"/>
<span>ActSpace</span>
</a>
<nav aria-label="页脚导航">
<a href="https://github.com/wakeup-jin/actspace-agent">GitHub ↗</a>
<a href={sitePath('/docs/')}>文档</a>
<a href={sitePath('/updates/')}>更新日志</a>
<a href={sitePath('/roadmap/')}>开发计划 ↗</a>
</nav>
<small>ACT + SPACE. A PLACE TO ACT.</small>
<small>© {new Date().getFullYear()} ACTSPACE</small>
</div>
</footer>
