---
import Screenshot from './Screenshot.astro';
import { homeFeatures } from '../lib/home-features';
import { sitePath } from '../lib/site-path';
import type { ImageMetadata } from 'astro';
import '../styles/showcase.css';
const assets = import.meta.glob<{ default: ImageMetadata }>('../assets/screenshots/*.png', { eager: true });
// 底板按截图比例算出显示宽度，图片未加载时也能占住正确的位置。
const ratio = (name: string) => {
  const image = assets[`../assets/screenshots/${name}`]?.default;
  return `--shot-ratio: ${image ? (image.width / image.height).toFixed(4) : 1.6}`;
};
// 英文开头的名称前补一个空格："了解 Review"。
const learnMore = (label: string) => `了解${/^[A-Za-z]/.test(label) ? ' ' : ''}${label}`;
---
<div class="showcase" data-showcase>
  {homeFeatures.map((feature, index) => <section class="showcase-step" data-step={index} aria-labelledby={`feature-${feature.id}`}>
    <div class="showcase-copy">
      <p class="feature-label">{feature.label}</p>
      <h3 id={`feature-${feature.id}`}>{feature.title}</h3>
      <p class="feature-description">{feature.description}</p>
      <ul>{feature.points.map(point => <li>{point}</li>)}</ul>
      <a class="text-link" href={sitePath(feature.href)}>{learnMore(feature.label)} <span class="arrow" aria-hidden="true">→</span></a>
    </div>
    <div class="showcase-inline showcase-frame" style={ratio(feature.image)}><Screenshot name={feature.image} title={feature.imageTitle} showCaption={false} sizes="(min-width: 760px) 680px, 80vw"/></div>
  </section>)}
  <div class="showcase-stage" aria-hidden="true">
    <div class="showcase-sticky">
      <div class="showcase-slides">
        {homeFeatures.map((feature, index) => <div class="showcase-slide showcase-frame" data-slide={index} style={ratio(feature.image)} inert>
          <Screenshot name={feature.image} title={feature.imageTitle} showCaption={false} sizes="(min-width: 1728px) 820px, 50vw"/>
        </div>)}
      </div>
      <div class="showcase-progress">{homeFeatures.map(() => <span data-progress></span>)}</div>
    </div>
  </div>
</div>
<script>
import { initializeShowcase } from '../scripts/showcase';
initializeShowcase();
</script>
