---
import Screenshot from './Screenshot.astro';
import { homeFeatures } from '../lib/home-features';
import { sitePath } from '../lib/site-path';
import '../styles/showcase.css';
---
<div class="showcase" data-showcase>
  {homeFeatures.map((feature, index) => <section class="showcase-step" data-step={index} aria-labelledby={`feature-${feature.id}`}>
    <div class="showcase-copy">
      <p class="feature-label">{feature.label}</p>
      <h3 id={`feature-${feature.id}`}>{feature.title}</h3>
      <p class="feature-description">{feature.description}</p>
      <ul>{feature.points.map(point => <li>{point}</li>)}</ul>
      <a class="text-link" href={sitePath(feature.href)}>了解{feature.label} <span aria-hidden="true">↗</span></a>
    </div>
    <div class="showcase-inline"><Screenshot name={feature.image} title={feature.imageTitle}/></div>
  </section>)}
  <div class="showcase-stage" aria-hidden="true">
    <div class="showcase-sticky">
      {homeFeatures.map((feature, index) => <div class="showcase-slide" data-slide={index} inert>
        <Screenshot name={feature.image} title={feature.imageTitle}/>
      </div>)}
    </div>
  </div>
</div>
<script>
import { initializeShowcase } from '../scripts/showcase';
initializeShowcase();
</script>
