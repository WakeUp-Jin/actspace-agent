---
import {sitePath} from "../lib/site-path";
interface Props { hero?: boolean; }
const links=[['/','产品'],['/docs/','文档'],['/blog/','博客'],['/updates/','更新日志']];
const active=(path:string)=>path==='/'?Astro.url.pathname===sitePath('/'):Astro.url.pathname.startsWith(sitePath(path));
---
<header class="site-header">
<div class="wrap header-inner">
<a class="brand" href={sitePath('/')} aria-label="ActSpace 首页">
<img class="brand-logo" src={sitePath("/media/actspace-logo.png")} alt="" width="600" height="370">
<span>ActSpace</span>
</a>
<nav class="nav" aria-label="主要导航">{links.map(([path,label])=>
<a href={sitePath(path)} aria-current={active(path)?'page':undefined}>{label}</a>)}</nav>
<div class="header-tools">
<a class="button primary" href={sitePath('/docs/getting-started/')}>开始使用 ↗</a>
<button class="menu-button" aria-expanded="false" aria-controls="mobile-menu">菜单</button>
</div>
</div>
<nav id="mobile-menu" class="mobile-menu" hidden aria-label="移动导航">{links.map(([path,label])=>
<a href={sitePath(path)}>{label}</a>)}</nav>
</header>
<script>const button=document.querySelector<HTMLButtonElement>('.menu-button');const menu=document.querySelector<HTMLElement>('#mobile-menu');button?.addEventListener('click',()=>{if(menu){menu.hidden=!menu.hidden;button.setAttribute('aria-expanded',String(!menu.hidden));}});document.addEventListener('keydown',event=>{if(event.key==='Escape'&&menu&&button){menu.hidden=true;button.setAttribute('aria-expanded','false');button.focus();}});</script>
