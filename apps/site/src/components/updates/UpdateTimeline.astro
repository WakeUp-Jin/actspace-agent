---
import type {ReleaseMonth} from '../../lib/releases/model';
import '../../styles/prose.css';
interface Props {months:ReleaseMonth[];compact?:boolean;}
const {months}=Astro.props;const labels={feature:'新功能',improvement:'改进',fix:'问题修复'};
---
{months.flatMap(month=>month.entries).map(entry=>
<article class="release-entry" id={entry.anchor}>
<aside>
<time datetime={entry.date}>{entry.date.replaceAll('-','.')}</time>
<p><span class="site-tag">产品更新</span></p>
</aside>
<div class="release-content">
<h2>{entry.title}</h2>{entry.sections.map(section=>
<section>
<h3>{labels[section.type]}</h3>
<ul class="docs-prose">{section.itemsHtml.map(html=>
<li set:html={html}/>)}</ul>
</section>)}</div>
</article>)}
