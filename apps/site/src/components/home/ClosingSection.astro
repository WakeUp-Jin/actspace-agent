---
import { sitePath } from '../../lib/site-path';
import { loadReleaseNotes } from '../../lib/releases/parse-release-notes';
const latest = (await loadReleaseNotes())[0];
---
<section class="wrap closing" aria-labelledby="closing-title">
  {latest && <a class="latest" href={sitePath(`/updates/#${latest.anchor}`)}>
    <span class="site-tag">产品更新</span>
    <time datetime={latest.date}>{latest.date.replaceAll('-', '.')}</time>
    <strong>{latest.title}</strong>
    <span class="text-link">查看更新 <span class="arrow" aria-hidden="true">→</span></span>
  </a>}
  <div class="stage stage-peach closing-stage">
    <h2 id="closing-title">给下一个问题，<br>一个空间</h2>
    <div class="hero-actions">
      <a class="button primary" href={sitePath('/docs/getting-started/')}>快速开始 <span class="arrow" aria-hidden="true">→</span></a>
      <a class="text-link" href="https://github.com/WakeUp-Jin/actspace-agent" target="_blank" rel="noreferrer noopener">在 GitHub 查看 <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>
