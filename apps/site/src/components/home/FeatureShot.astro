---
// 真实界面功能块：左边说明与要点，右边是产品截图。要点和截图里的区域一一对应，
// 舞台进入视口后依次聚焦每个要点；悬停或点按要点会停在那一处（home-focus.ts）。
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';
import { statusLabel, type FocusPoint } from '../../lib/home-features';

interface Props {
  id: string;
  status: keyof typeof statusLabel;
  tag: string;
  title: string;
  description: string;
  points: FocusPoint[];
  image: ImageMetadata;
  alt: string;
  windowTitle: string;
  note: string;
  stage: 'mint' | 'slate' | 'peach';
  reverse?: boolean;
  /** 竖长的截图（如右侧面板）用竖版窗口。 */
  portrait?: boolean;
  /** 截图比 5:4 扁很多时按原图比例显示，不放大裁切。 */
  natural?: boolean;
  link: { href: string; label: string };
}

const { id, status, tag, title, description, points, image, alt, windowTitle, note, stage, reverse = false, portrait = false, natural = false, link } = Astro.props;
const original = await getImage({ src: image, format: 'png' });
const widths = [...new Set([800, 1200, 1600, image.width].filter((width) => width <= image.width))];
---
<section class:list={['wrap', 'feature', { reverse }]} id={id} aria-labelledby={`${id}-title`}>
  <div class="feature-copy">
    <p class="feature-tags"><span class:list={['pill', status]}>{statusLabel[status]}</span><span>{tag}</span></p>
    <h2 id={`${id}-title`}>{title}</h2>
    <p class="feature-description">{description}</p>
    <ol class="feature-points focus-points">
      {points.map((point, index) => <li>
        <button type="button" data-focus-point={index} aria-controls={`${id}-shot`}>
          <span>0{index + 1}</span><b>{point.title}</b><small>{point.detail}</small>
        </button>
      </li>)}
    </ol>
    <a class="text-link" href={link.href}>{link.label} <span class="arrow" aria-hidden="true">→</span></a>
  </div>
  <div class:list={['stage', `stage-${stage}`, 'feature-stage', 'focus-stage']} data-focus-stage data-points={JSON.stringify(points.map((point) => point.rect))} data-source-width={image.width}>
    <span class="mock-note">{note}</span>
    <div class:list={['win', 'focus-win', { portrait }]} id={`${id}-shot`}>
      <div class="win-bar"><i></i><i></i><i></i><em>{windowTitle}</em></div>
      <div class="focus-view" data-focus-view style={natural ? `aspect-ratio: ${image.width} / ${image.height}` : undefined}>
        <div class="focus-canvas" data-focus-canvas>
          <Image src={image} alt={alt} format="webp" quality={88} widths={widths} sizes="(max-width: 900px) 170vw, 1200px" loading="lazy" draggable="false" />
          <div class="focus-ring" data-focus-ring aria-hidden="true"><span data-focus-label></span></div>
        </div>
      </div>
    </div>
    <a class="focus-open screenshot-link" href={original.src} aria-label={`查看原图：${alt}`} data-alt={alt}>查看原图</a>
  </div>
</section>
