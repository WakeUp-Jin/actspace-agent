---
import { blogHref, getPublicPosts, readingTime } from "../../lib/blog";
import { sitePath } from "../../lib/site-path";

const posts = (await getPublicPosts()).slice(0, 3);
---

{posts.length > 0 && (
  <section class="latest-posts site-section" aria-labelledby="latest-posts-title">
    <div class="site-page">
      <div class="section-heading">
        <div>
          <p class="site-kicker">From the blog</p>
          <h2 id="latest-posts-title">把实现背后的判断，写成可以复用的思考。</h2>
        </div>
        <a href={sitePath("/blog/")}>浏览全部文章 <span aria-hidden="true">→</span></a>
      </div>

      <div class="posts-grid">
        {posts.map((post) => (
          <article>
            <a class="cover" href={sitePath(blogHref(post))}><img src={sitePath(post.data.cover)} alt="" /></a>
            <div>
              <p>{post.data.publishedAt.toLocaleDateString("zh-CN")} · {readingTime(post.body ?? "")} 分钟</p>
              <h3><a href={sitePath(blogHref(post))}>{post.data.title}</a></h3>
              <span>{post.data.tags[0]}</span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .latest-posts {
    background: var(--site-canvas);
  }

  .section-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 32px;
    align-items: end;
    margin-bottom: clamp(48px, 7vw, 86px);
  }

  h2 {
    max-width: 860px;
    margin: 26px 0 0;
    font-size: clamp(42px, 5vw, 70px);
    font-weight: 520;
    letter-spacing: -0.06em;
    line-height: 1.05;
  }

  .section-heading > a {
    padding-bottom: 8px;
    color: var(--site-body);
    text-decoration: none;
    font-size: 14px;
    font-weight: 650;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  article {
    overflow: hidden;
    border: 1px solid var(--site-line);
    border-radius: 15px;
    background: var(--site-surface);
  }

  .cover {
    display: block;
    aspect-ratio: 5 / 3;
    overflow: hidden;
  }

  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  article > div {
    padding: 24px;
  }

  article p {
    color: var(--site-muted);
    font-family: var(--site-font-mono);
    font-size: 9px;
  }

  h3 {
    margin-block: 22px 32px;
    font-family: var(--site-font-serif);
    font-size: 27px;
    font-weight: 500;
    line-height: 1.1;
  }

  h3 a {
    text-decoration: none;
  }

  article span {
    color: var(--site-muted);
    font-size: 11px;
  }

  @media (max-width: 900px) {
    .posts-grid {
      grid-template-columns: 1fr;
    }

    .section-heading {
      grid-template-columns: 1fr;
    }
  }
</style>
