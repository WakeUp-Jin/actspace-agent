---
import { getImage } from 'astro:assets';
import { sitePath } from '../../lib/site-path';
import character from '../../assets/blog/covers/character-01.png';
// 精灵只在窗口侧栏「Actor 名册」前出现这一处，作为小图标；不是首屏主角。
const avatar = await getImage({ src: character, width: 48, format: 'webp', quality: 85 });
const tools = [
  ['read', '读取文件', '按需读取项目文件，内容进入对话'],
  ['edit', '编辑', '直接修改文件，改动进入 Review'],
  ['term', '终端', '在你的项目里执行命令，输出回到对话'],
  ['browser', 'Browser Use', '打开网页、点击与截图，需要浏览器的任务才用'],
];
const behaviors = [
  ['skills', 'Skills', '把领域经验按需加载给 Agent'],
  ['approve', '审批策略', '会改变环境的命令先问你'],
  ['sub', '子 Agent', '把独立检索派给子 Agent，主会话只收摘要'],
];
const contexts = [
  ['prog', '渐进披露', '用到哪个文件才放进上下文'],
  ['comp', '压缩', '快到上限时把旧历史压成结构化摘要'],
  ['panel', '上下文面板', '逐次查看每次请求带了什么'],
];
// 上下文面板的分类，颜色在 home.css 的 [data-c] 上。
const categories = [['sys', '系统提示词'], ['tools', '工具'], ['rules', '规则'], ['skills', 'Skills'], ['sum', '会话摘要'], ['conv', '会话内容']];
---
<section class="hero" aria-labelledby="hero-title">
  <div class="wrap hero-inner">
    <div class="hero-top">
      <div>
        <h1 id="hero-title" tabindex="-1"><span>会自我进化的</span><span>Agent 运行空间</span></h1>
      </div>
      <div>
        <p class="lede"><b>每一个问题，都有它的空间。</b>今天它在本地项目里读代码、调工具、交付可审阅的改动；接下来，会在不同场景里长成专业的 Actor。</p>
        <div class="hero-actions">
          <a class="button primary" href={sitePath('/docs/getting-started/')}>快速开始 <span class="arrow" aria-hidden="true">→</span></a>
          <a class="text-link" href={sitePath('/docs/what-is-actspace/#产品理念')}>阅读产品理念 <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>

    <div class="stage stage-peach hero-stage" data-hero-stage>
      <svg class="stage-lines" aria-hidden="true"></svg>
      <div class="app" data-hero-window role="img" aria-label="ActSpace 桌面端演示：Agent 读取登录页、加载 Skill、派子 Agent 查找校验函数、修改文件、经审批运行测试，最后交付改动">
        <aside class="side" aria-hidden="true">
          <div class="lights"><i></i><i></i><i></i><span></span>
            <svg class="i" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 3v18"/></svg></div>
          <div class="app-nav"><svg class="i" viewBox="0 0 24 24"><path d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.4 2.6a1 1 0 0 1 3 3L12.4 14.6l-3.7 1 1-3.7z"/></svg>新建会话<kbd>⌘N</kbd></div>
          <div class="app-nav"><svg class="i" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><path d="M17.5 3v7M14 6.5h7"/></svg>新建 Space</div>
          <div class="app-nav"><svg class="i" viewBox="0 0 24 24"><rect x="14" y="3" width="7" height="7" rx="1"/><path d="M10 21V8a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-5a1 1 0 0 0-1-1H3"/></svg>扩展</div>
          <div class="app-nav"><span class="avatar" style={`background-image:url(${avatar.src})`}></span>Actor 名册<small>8</small></div>
          <h6>工作区</h6>
          <div class="app-nav"><svg class="i" viewBox="0 0 24 24"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.7-.9l-.8-1.2A2 2 0 0 0 7.9 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/></svg>acme-web</div>
          <div class="ses on"><span>把登录页的表单校验补完</span><i class="spin" data-h="ses-spin"></i><small data-h="ses-time" hidden>刚刚</small></div>
          <div class="ses"><span>修复路由守卫</span><small>2 小时</small></div>
          <div class="ses"><span>整理 API 类型</span><small>昨天</small></div>
          <div class="app-nav foot"><svg class="i" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9 7 7M17 17l2.1 2.1M4.9 19.1 7 17M17 7l2.1-2.1"/></svg>设置</div>
        </aside>

        <div class="main">
          <div class="top">
            <span class="lights top-lights" aria-hidden="true"><i></i><i></i><i></i></span>
            <svg class="i" viewBox="0 0 24 24"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
            <b>把登录页的表单校验补完</b><span class="sp"></span>
            <span class="pt"><svg class="i" viewBox="0 0 24 24"><path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg></span>
            <span class="pt" data-h="panel-btn"><svg class="i" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M15 3v18"/></svg></span>
          </div>
          <div class="body">
            <div class="conv">
              <div class="scroll" data-h="scroll"><div class="feed" data-h="feed"></div></div>
              <div class="dock">
                <div class="chips"><span>Review</span><span class="dots">•••</span></div>
                <div class="composer">
                  <svg class="i faint" viewBox="0 0 24 24"><path d="M5 12h14M12 5v14"/></svg>
                  <span class="ph" data-h="ph">继续追问…</span>
                  <span class="md">deepseek-flash <svg class="i s12" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></svg></span>
                  <span class="send" data-h="send"><svg class="i s14" viewBox="0 0 24 24"><path d="m5 12 7-7 7 7M12 19V5"/></svg></span>
                </div>
                <div class="meta-row">
                  <span><svg class="i s13" viewBox="0 0 24 24"><path d="M20 16V7a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v9m16 0H4m16 0 1.3 2.6a1 1 0 0 1-.9 1.4H3.6a1 1 0 0 1-.9-1.4L4 16"/></svg>本机</span>
                  <span><svg class="i s13" viewBox="0 0 24 24"><path d="M20 13c0 5-3.5 7.5-7.7 9a1 1 0 0 1-.6 0C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.2-2.7a1.2 1.2 0 0 1 1.6 0C14.5 3.8 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg><span data-h="perm">自动</span></span>
                  <span class="ring" data-h="ring"><svg viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="6"/><circle cx="8" cy="8" r="6" stroke-dasharray="37.7" stroke-dashoffset="37.7" data-h="ring-arc"/></svg><span data-h="ring-txt">0%</span></span>
                </div>
              </div>
            </div>
            <aside class="panel" data-h="panel">
              <div class="pin">
                <div class="ptabs"><span>上下文</span><svg class="i" viewBox="0 0 24 24"><path d="M5 12h14M12 5v14"/></svg></div>
                <div class="pcard">
                  <h5>当前上下文<small>deepseek-flash</small></h5>
                  <div class="big"><b><span data-h="tok">≈0K</span><small> / 200K tokens</small></b><span><b data-h="pct">0%</b> 已用</span></div>
                  <div class="bar" data-h="bar">{categories.map(([id]) => <i data-c={id}></i>)}<span class="th"></span></div>
                  <div class="thl">自动压缩 ≈160K</div>
                  <div class="leg">{categories.map(([id, name]) => <div data-c={id}>{name}<b data-l={id}>0K</b></div>)}</div>
                </div>
                <div class="evh">上下文事件<small data-h="ev-count">0 条</small></div>
                <div class="evs" data-h="evs"></div>
              </div>
            </aside>
          </div>
        </div>
      </div>
      <div class="grp g-tools"><h6>工具</h6><div class="ms">
        {tools.map(([id, name, tip]) => <button type="button" class="m" aria-pressed="true" data-m={id} data-side="l" data-tip={`${name}|${tip}`}><span class="t">{name}</span><i class="sw"></i></button>)}
      </div></div>
      <div class="grp g-beh"><h6>行为</h6><div class="ms">
        {behaviors.map(([id, name, tip]) => <button type="button" class="m" aria-pressed="true" data-m={id} data-side="r" data-tip={`${name}|${tip}`}><span class="t">{name}</span><i class="sw"></i></button>)}
      </div></div>
      <div class="grp g-ctx"><h6>上下文</h6><div class="ms">
        {contexts.map(([id, name, tip]) => <button type="button" class="m" aria-pressed="true" data-m={id} data-side="b" data-tip={`${name}|${tip}`}><span class="t">{name}</span><i class="sw"></i></button>)}
      </div></div>
      <p class="count">本任务启用 <b data-hero-count>0</b> / 10 个插件<small>悬停看说明 · 点击开关后重跑</small></p>
      <div class="tip" role="tooltip"></div>
    </div>
  </div>
</section>
<script>
import { initializeHeroStage } from '../../scripts/home-stage';
initializeHeroStage();
</script>
