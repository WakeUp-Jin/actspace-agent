---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import screenshots from '../lib/screenshots.json';
interface Props { name: keyof typeof screenshots; title: string; eager?: boolean; showCaption?: boolean; sizes?: string; }
const { name, title, eager = false, showCaption = true, sizes = '(max-width: 760px) calc(100vw - 48px), 800px' } = Astro.props;
const assets = import.meta.glob<{ default: ImageMetadata }>('../assets/screenshots/*.png', { eager: true });
const source = assets[`../assets/screenshots/${name}`]?.default;
const shot = screenshots[name];
const widths = source ? [...new Set([480, 800, 1200, 1600, 2400, source.width].filter(width => width <= source.width))] : [];
// Emit the original explicitly: the image viewer opens it only on demand.
const original = source ? await getImage({ src: source, format: 'png' }) : undefined;
---
<figure class:list={['product-shot', { 'screenshot-placeholder': !source }]} data-screenshot={name}>
  {source ? <>
    <a class="screenshot-link" href={original!.src} aria-label={`放大：${title}`}>
      <Image src={source} alt={title} format="webp" quality={85} widths={widths} sizes={sizes} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} />
    </a>
    {showCaption && <figcaption>{title}</figcaption>}
  </> : <>
    <svg class="screenshot-mark" width="36" height="36" viewBox="0 0 36 36" fill="none" aria-hidden="true"><rect x="3" y="5" width="30" height="26" rx="4" stroke="currentColor"/><path d="M3 12h30M11 12v19" stroke="currentColor"/><path d="M16 20h11m-11 5h7" stroke="currentColor" stroke-linecap="round"/></svg>
    <figcaption>
      <span class="screenshot-label">待补实拍 · {String(shot.number).padStart(2, '0')}</span>
      <strong>{title}</strong>
      <code>{name}</code>
      <p>{shot.instruction}</p>
    </figcaption>
  </>}
</figure>
