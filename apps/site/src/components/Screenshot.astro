---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import screenshots from '../lib/screenshots.json';
interface Props { name: keyof typeof screenshots; title: string; eager?: boolean; }
const { name, title, eager = false } = Astro.props;
const assets = import.meta.glob<{ default: ImageMetadata }>('../assets/screenshots/*.png', { eager: true });
const source = assets[`../assets/screenshots/${name}`]?.default;
const shot = screenshots[name];
---
<figure class:list={['product-shot', { 'screenshot-placeholder': !source }]} data-screenshot={name}>
  {source ? <>
    <a class="screenshot-link" href={source.src} aria-label={`放大：${title}`}>
      <Image src={source} alt={title} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} />
    </a>
    <figcaption>{title}</figcaption>
  </> : <>
    <svg class="screenshot-mark" width="36" height="36" viewBox="0 0 36 36" fill="none" aria-hidden="true"><rect x="3" y="5" width="30" height="26" rx="4" stroke="currentColor"/><path d="M3 12h30M11 12v19" stroke="currentColor"/><path d="M16 20h11m-11 5h7" stroke="currentColor" stroke-linecap="round"/></svg>
    <figcaption>
      <span class="screenshot-label">待补实拍 · {String(shot.number).padStart(2, '0')}</span>
      <strong>{title}</strong>
      <code>{name}</code>
      <p>{shot.instruction}</p>
    </figcaption>
  </>}
</figure>
