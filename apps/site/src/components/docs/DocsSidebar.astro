---
import type { DocsEntry, DocsGroupId } from "../../lib/docs-navigation";
import { docsGroups, docsHref } from "../../lib/docs-navigation";
import { sitePath } from "../../lib/site-path";

interface Props {
  docs: DocsEntry[];
  currentGroup: DocsGroupId;
  currentId?: string;
}

const { docs, currentGroup, currentId } = Astro.props;
const currentGroupConfig = docsGroups.find((group) => group.id === currentGroup);
const entries = docs.filter((entry) => entry.data.group === currentGroup);
const isDocsHome = currentGroup === "getting-started" && currentId === undefined;
---

<nav class="docs-sidebar" aria-label={`${currentGroupConfig?.label ?? "文档"}目录`}>
  <div class="desktop-docs-nav">
    <p class="docs-group-label">{currentGroupConfig?.label}</p>
    <ul>
      {currentGroup === "getting-started" && (
        <li>
          <a class:list={{ active: isDocsHome }} href={sitePath("/docs/")} aria-current={isDocsHome ? "page" : undefined}>
            概览
          </a>
        </li>
      )}
      {entries.map((entry) => (
        <li>
          <a class:list={{ active: entry.id === currentId }} href={sitePath(docsHref(entry))} aria-current={entry.id === currentId ? "page" : undefined}>
            {entry.data.title}
          </a>
        </li>
      ))}
    </ul>
  </div>

  <details class="mobile-docs-nav">
    <summary>浏览{currentGroupConfig?.label}</summary>
    <ul>
      {currentGroup === "getting-started" && (
        <li><a class:list={{ active: isDocsHome }} href={sitePath("/docs/")}>概览</a></li>
      )}
      {entries.map((entry) => (
        <li><a class:list={{ active: entry.id === currentId }} href={sitePath(docsHref(entry))}>{entry.data.title}</a></li>
      ))}
    </ul>
  </details>
</nav>

<style>
  .docs-sidebar {
    position: sticky;
    top: 150px;
    max-height: calc(100vh - 170px);
    overflow-y: auto;
    padding: 7px 20px 40px 0;
    scrollbar-width: thin;
  }

  .mobile-docs-nav {
    display: none;
  }

  .docs-group-label {
    margin: 0 0 10px 10px;
    color: var(--site-ink);
    font-size: 13px;
    font-weight: 700;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: block;
    border-radius: 7px;
    padding: 8px 10px;
    color: var(--site-body);
    text-decoration: none;
    font-size: 13px;
    line-height: 1.45;
  }

  a:hover {
    color: var(--site-ink);
    background: var(--site-canvas-soft);
  }

  a.active {
    color: var(--site-ink);
    background: var(--site-surface);
    box-shadow: inset 0 0 0 1px var(--site-line);
    font-weight: 650;
  }

  @media (max-width: 760px) {
    .docs-sidebar {
      position: static;
      max-height: none;
      border-bottom: 1px solid var(--site-line);
      padding: 0 0 22px;
    }

    .mobile-docs-nav {
      display: block;
      border: 1px solid var(--site-line);
      border-radius: 9px;
      padding: 0 12px 12px;
      background: var(--site-surface);
    }

    .mobile-docs-nav summary {
      min-height: 44px;
      align-content: center;
      cursor: pointer;
      font-size: 13px;
      font-weight: 650;
    }

    .desktop-docs-nav {
      display: none;
    }

    .mobile-docs-nav ul {
      margin-top: 6px;
    }
  }
</style>
