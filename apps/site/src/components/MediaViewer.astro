<dialog class="media-dialog" aria-label="图片预览">
  <button type="button" class="media-close" data-close-image aria-label="关闭图片预览" title="关闭（Esc）"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button>
  <img alt="" />
</dialog>
<script>
import { initializeImageLoading } from '../scripts/image-loading';

const dialog = document.querySelector<HTMLDialogElement>('.media-dialog')!;
const expanded = dialog.querySelector('img')!;
let trigger: HTMLElement | null = null;
// Plain Markdown images gain a keyboard-accessible link; existing links retain their intent.
document.querySelectorAll<HTMLImageElement>('.docs-prose img').forEach(img => {
  if (img.closest('a')) return;
  const link = document.createElement('a');
  link.href = img.currentSrc || img.src;
  link.className = 'screenshot-link';
  link.setAttribute('aria-label', `放大：${img.alt || '内容图片'}`);
  img.replaceWith(link);
  link.append(img);
});
document.querySelectorAll<HTMLAnchorElement>('.screenshot-link').forEach(link => {
  link.addEventListener('click', event => {
    if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    const img = link.querySelector('img');
    if (!img) return;
    event.preventDefault();
    trigger = link;
    expanded.src = link.href;
    expanded.alt = img.alt;
    dialog.showModal();
    document.documentElement.classList.add('media-open');
  });
});
dialog.querySelector('[data-close-image]')?.addEventListener('click', () => dialog.close());
dialog.addEventListener('click', event => { if (event.target === dialog) dialog.close(); });
dialog.addEventListener('close', () => {
  document.documentElement.classList.remove('media-open');
  trigger?.focus({preventScroll:true});
});

initializeImageLoading();
</script>
