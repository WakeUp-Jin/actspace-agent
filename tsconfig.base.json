{
  "compilerOptions": {
    "target": "ES2022",
    "moduleResolution": "Node",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@actspace/shared": [
        "packages/shared/src"
      ],
      "@actspace/shared/*": [
        "packages/shared/src/*"
      ],
      "@actspace/agent-core": [
        "packages/agent-core/src"
      ],
      "@actspace/agent-core/*": [
        "packages/agent-core/src/*"
      ]
    }
  }
}
