{
  "compilerOptions": {
    "target": "ES2022",
    "moduleResolution": "Node",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@actspace/shared": [
        "packages/util/shared/src"
      ],
      "@actspace/shared/*": [
        "packages/util/shared/src/*"
      ],
      "@actspace/cordis-adapter": [
        "packages/composition/cordis-adapter/src"
      ],
      "@actspace/cordis-adapter/*": [
        "packages/composition/cordis-adapter/src/*"
      ]
    }
  }
}
