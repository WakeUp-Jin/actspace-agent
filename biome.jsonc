{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    // 只检查产品与脚本代码；docs/ 下的 demo、各类 fixture 和 html 不是 lint 对象。
    "includes": [
      "apps/**",
      "packages/**",
      "scripts/**",
      "browser-bridge/**",
      "!**/test-fixtures",
      "!**/generated",
      "!**/*.html",
      // Biome 看不到 .astro 模板里的引用，会把模板用到的 import 误报为未使用。
      "!**/*.astro"
    ]
  },
  // 格式化只配置、不强制：CI 只跑 lint；`pnpm format` 只格式化相对 main 改过的文件。
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "css": {
    // 样式由 check:frontend-tokens / check:frontend-theme 守，Tailwind 语法 Biome 也不认。
    "linter": { "enabled": false },
    "formatter": { "enabled": false }
  },
  "json": {
    "formatter": { "enabled": false }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      // 桌面端 a11y 是独立专题，先不进门禁。
      "a11y": { "preset": "none" },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "useExhaustiveDependencies": {
          "level": "error",
          "options": {
            // `useEffect(fn, [refreshKey])` 这类「把 key / revision / tick 当触发器」的写法在仓库里是有意的成规模用法，
            // React 官方的 exhaustive-deps 也不把 effect 的多余依赖当错误；这里只追「漏依赖」，不追「多依赖」。
            "reportUnnecessaryDependencies": false
          }
        },
        // `case x: return this.handle();` 在 void 方法里是仓库惯用写法，tsc 已经约束返回类型。
        "noVoidTypeReturn": "off",
        // `useSourceExtension` 这类 use* 命名的普通 API 会被误判为 React hook。
        "useHookAtTopLevel": "off"
      },
      "style": {
        // 2026-11-09 已用 tsc 逐处核对：删掉所有「去掉也不报错」的 `!`，剩下的每一处都在表达 tsc 看不见的不变量
        // （`if (map.has(k)) map.get(k)!`、`length > 0 ? arr.shift()!`、闭包里已经赋值的局部变量等），改成 `?.` / 抛错是改行为。
        // 仓库没开 noUncheckedIndexedAccess，`arr[i]!` 不需要也不要写；新增 `!` 只能用于上述不变量。
        "noNonNullAssertion": "off"
      },
      "suspicious": {
        // 产品代码用 `unknown` 加收窄；测试里的 mock / 响应体允许 `any`，见下方 overrides。
        "noExplicitAny": "error",
        // forEach 回调一律写块语句 `x => { f(x); }`，让 map / filter 漏 return 能被这条规则抓到。
        "useIterableCallbackReturn": "error",
        // `x ??= init`、`(map[k] ??= []).push(v)`、`return this.#closing = …` 是仓库成规模使用的惰性初始化 / 记忆化写法，
        // 全部有意为之；逐处拆成语句只会变长。
        "noAssignInExpressions": "off",
        // 命中的全是 diff 行、token、文本片段、坐标标签这类没有稳定身份、也不会重排的派生列表，index 就是正确的 key；
        // 有身份的数据（message、session、tool call）本来就用 id。
        "noArrayIndexKey": "off",
        // 终端 / ANSI 清洗代码里的控制字符正则是有意为之。
        "noControlCharactersInRegex": "off",
        // `let x; try { x = await ... } catch {}` 依赖 tsc 控制流推断，不是 implicit any。
        "noImplicitAnyLet": "off",
        "noExportsInTest": "off",
        // `(…) => Handlers | void` 表示回调可以不返回；换成 `| undefined` 会让 tsc 要求每个分支显式 return。
        // 这和 React 的 `EffectCallback = () => void | Destructor` 是同一种写法，不是误用。
        "noConfusingVoidType": "off"
      },
      "nursery": {
        // 类型推断不完整，可能漏报，但不会误报：明确不等待的调用写 `void`。
        "noFloatingPromises": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/test/**", "**/tests/**", "**/*.test.*", "**/*.spec.*"],
      "linter": {
        "rules": {
          "correctness": {
            // 测试里在 it() 内定义 Fixture 组件、用只 throw 的 generator 模拟流失败都是常规写法。
            "noComponentHookFactories": "off",
            "useYield": "off"
          },
          "suspicious": {
            // 测试里 mock 对象、拦截到的请求体用 `any` 比为每个形状写类型更直接。
            "noExplicitAny": "off"
          }
        }
      }
    }
  ]
}
